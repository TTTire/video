{"fps": 30, "total": 14377, "scenes": [{"scene": "menu", "from": 0, "dur": 646, "steps": [9, 109, 190, 270, 370, 418, 485, 579]}, {"scene": "sorry", "from": 646, "dur": 429, "steps": [0, 107, 181, 261, 348]}, {"scene": "contrast", "from": 1075, "dur": 348, "steps": [0, 100, 193, 254]}, {"scene": "wrong", "from": 1423, "dur": 436, "steps": [0, 67, 141, 215, 282, 363]}, {"scene": "door", "from": 1859, "dur": 261, "steps": [0, 107, 181]}, {"scene": "series", "from": 2120, "dur": 201, "steps": [0, 120]}, {"scene": "bridge", "from": 2321, "dur": 346, "steps": [0, 74, 128, 202, 269]}, {"scene": "chapter", "from": 2667, "dur": 66, "steps": [0], "chapter": 1, "title": "弹性不长在东西身上"}, {"scene": "define", "from": 2733, "dur": 629, "steps": [0, 11, 118, 199, 279, 327, 407, 494, 542]}, {"scene": "direction", "from": 3362, "dur": 228, "steps": [0, 67, 141]}, {"scene": "attribute", "from": 3590, "dur": 542, "steps": [0, 81, 161, 242, 335, 448]}, {"scene": "comments", "from": 4132, "dur": 831, "steps": [0, 120, 187, 294, 361, 461, 535, 602, 670, 757]}, {"scene": "three", "from": 4963, "dur": 474, "steps": [0, 119, 180, 274, 367]}, {"scene": "budget", "from": 5437, "dur": 348, "steps": [0, 113, 187, 294]}, {"scene": "time", "from": 5785, "dur": 274, "steps": [0, 74, 167]}, {"scene": "notonmenu", "from": 6059, "dur": 183, "steps": [0, 61]}, {"scene": "chapter", "from": 6242, "dur": 66, "steps": [0], "chapter": 2, "title": "同一次涨价，怎么挑出两种人"}, {"scene": "tobacco", "from": 6308, "dur": 803, "steps": [0, 0, 92, 192, 279, 360, 414, 501, 575, 669, 749]}, {"scene": "split", "from": 7111, "dur": 631, "steps": [0, 87, 148, 242, 316, 390, 437, 524]}, {"scene": "two", "from": 7742, "dur": 811, "steps": [0, 87, 174, 261, 348, 402, 476, 537, 637, 711]}, {"scene": "bain", "from": 8553, "dur": 689, "steps": [0, 100, 187, 235, 328, 422, 535, 589]}, {"scene": "netflix2011", "from": 9242, "dur": 535, "steps": [0, 45, 146, 193, 274, 354, 454]}, {"scene": "netflix2025", "from": 9777, "dur": 524, "steps": [0, 74, 148, 221, 302, 363, 443]}, {"scene": "substitute", "from": 10301, "dur": 637, "steps": [0, 100, 145, 245, 306, 386, 453, 521]}, {"scene": "chapter", "from": 10938, "dur": 66, "steps": [0], "chapter": 3, "title": "你是橡皮筋还是铁丝"}, {"scene": "revenue", "from": 11004, "dur": 815, "steps": [0, 31, 112, 192, 246, 301, 355, 435, 480, 554, 635, 715]}, {"scene": "guess", "from": 11819, "dur": 400, "steps": [0, 81, 168, 213, 293]}, {"scene": "self", "from": 12219, "dur": 798, "steps": [0, 119, 187, 261, 341, 428, 502, 563, 656, 717]}, {"scene": "prepare", "from": 13017, "dur": 348, "steps": [0, 100, 200, 254]}, {"scene": "potato", "from": 13365, "dur": 743, "steps": [0, 93, 167, 287, 354, 441, 502, 589, 663]}, {"scene": "next", "from": 14108, "dur": 269, "steps": [0, 81, 129]}], "subs": [{"from": 9, "dur": 96, "text": "2020 年 4 月，餐馆刚恢复堂食"}, {"from": 109, "dur": 76, "text": "北京一位顾客在微博上"}, {"from": 190, "dur": 76, "text": "晒了一张海底捞的菜单"}, {"from": 270, "dur": 96, "text": "血旺半份，从 16 块涨到 23 块"}, {"from": 370, "dur": 43, "text": "一共八小片"}, {"from": 418, "dur": 63, "text": "半份土豆片 13 块"}, {"from": 485, "dur": 89, "text": "算下来一片土豆 1 块 5"}, {"from": 579, "dur": 63, "text": "米饭 7 块钱一碗"}, {"from": 646, "dur": 102, "text": "海底捞回应，整体涨幅控制在 6%"}, {"from": 753, "dur": 69, "text": "几天后，4 月 10 日"}, {"from": 827, "dur": 76, "text": "海底捞发了一封致歉信"}, {"from": 907, "dur": 82, "text": "说这是管理层的错误决策"}, {"from": 994, "dur": 76, "text": "价格全部恢复到停业前"}, {"from": 1075, "dur": 96, "text": "上一期我们刚看过另一支队伍："}, {"from": 1175, "dur": 89, "text": "奢侈品一年涨两次，每次 10%"}, {"from": 1268, "dur": 56, "text": "门口照样排长队"}, {"from": 1329, "dur": 89, "text": "火锅只涨 6%，就被骂到道歉"}, {"from": 1423, "dur": 63, "text": "你第一反应可能是："}, {"from": 1490, "dur": 69, "text": "火锅不够高级，不配涨；"}, {"from": 1564, "dur": 69, "text": "或者，海底捞不够硬气"}, {"from": 1638, "dur": 63, "text": "我一开始也是沿着"}, {"from": 1705, "dur": 76, "text": "“东西值不值”这条路想的"}, {"from": 1786, "dur": 69, "text": "后来发现，想错了方向"}, {"from": 1859, "dur": 102, "text": "决定你走不走的，不是桌上那道菜"}, {"from": 1966, "dur": 69, "text": "而是你推门出去以后"}, {"from": 2040, "dur": 76, "text": "还有没有别的地方可去"}, {"from": 2120, "dur": 115, "text": "这里是像素呼吸的《100个经济学原理》"}, {"from": 2240, "dur": 76, "text": "第 8 个，需求价格弹性"}, {"from": 2321, "dur": 69, "text": "上期结尾我问了一句："}, {"from": 2395, "dur": 50, "text": "同样一次涨价"}, {"from": 2449, "dur": 69, "text": "为什么有人一涨就走"}, {"from": 2523, "dur": 63, "text": "有人涨多少都留下"}, {"from": 2590, "dur": 69, "text": "这期就回答这个问题"}, {"from": 2664, "dur": 76, "text": "先把这个词翻译成人话"}, {"from": 2744, "dur": 102, "text": "需求价格弹性，说的是价格动一下"}, {"from": 2851, "dur": 76, "text": "你买的数量跟着动多少"}, {"from": 2932, "dur": 76, "text": "价格涨 10%，你少买 20%"}, {"from": 3012, "dur": 43, "text": "这叫弹性大"}, {"from": 3060, "dur": 76, "text": "像一根橡皮筋，一拉就长"}, {"from": 3140, "dur": 82, "text": "价格涨 10%，你只少买 2%"}, {"from": 3227, "dur": 43, "text": "这叫弹性小"}, {"from": 3275, "dur": 82, "text": "像一根铁丝，怎么拉都不动"}, {"from": 3362, "dur": 63, "text": "上一期的需求定律"}, {"from": 3429, "dur": 69, "text": "只说了方向：贵了少买"}, {"from": 3503, "dur": 82, "text": "弹性说的是幅度：少买多少"}, {"from": 3590, "dur": 76, "text": "大多数人对弹性的理解"}, {"from": 3671, "dur": 76, "text": "是把它当成东西的属性"}, {"from": 3751, "dur": 76, "text": "盐是铁丝，火锅是橡皮筋"}, {"from": 3832, "dur": 89, "text": "奢侈品是铁丝，奶茶是橡皮筋"}, {"from": 3925, "dur": 109, "text": "照这个说法，海底捞道歉就很好解释："}, {"from": 4038, "dur": 89, "text": "火锅本来就是橡皮筋，涨不得"}, {"from": 4132, "dur": 115, "text": "但你回头想想那张菜单下面的评论区"}, {"from": 4252, "dur": 63, "text": "大概就是两种声音"}, {"from": 4319, "dur": 102, "text": "同样是看到一片土豆 1 块 5"}, {"from": 4426, "dur": 63, "text": "有人说“再也不去了”"}, {"from": 4493, "dur": 96, "text": "也有人说“又不是天天吃，无所谓”"}, {"from": 4593, "dur": 69, "text": "同一家店，同一张菜单"}, {"from": 4667, "dur": 63, "text": "一部分人是橡皮筋"}, {"from": 4734, "dur": 63, "text": "另一部分人是铁丝"}, {"from": 4802, "dur": 82, "text": "所以弹性不长在火锅身上"}, {"from": 4889, "dur": 69, "text": "长在吃火锅的人身上"}, {"from": 4963, "dur": 115, "text": "那什么决定一个人是橡皮筋还是铁丝"}, {"from": 5082, "dur": 56, "text": "说到底就三件事"}, {"from": 5143, "dur": 89, "text": "第一，他有没有别的地方可去"}, {"from": 5237, "dur": 89, "text": "海底捞楼下就有十家火锅店"}, {"from": 5330, "dur": 102, "text": "而上期那只包，只有专柜才买得到"}, {"from": 5437, "dur": 109, "text": "第二，这笔钱在他口袋里占多大一块"}, {"from": 5550, "dur": 69, "text": "人均两百多的一顿饭"}, {"from": 5624, "dur": 102, "text": "对月薪五千的人和月薪五万的人"}, {"from": 5731, "dur": 50, "text": "不是同一笔钱"}, {"from": 5785, "dur": 69, "text": "第三，他有没有时间换"}, {"from": 5859, "dur": 89, "text": "今天晚上就要请客，你只能认；"}, {"from": 5952, "dur": 102, "text": "下个月再聚，你有的是时间挑别家"}, {"from": 6059, "dur": 56, "text": "替代品、预算、时间"}, {"from": 6120, "dur": 115, "text": "这三样东西，没有一样是写在菜单上的"}, {"from": 6239, "dur": 43, "text": "那这三件事"}, {"from": 6287, "dur": 109, "text": "是怎么在一群人身上同时起作用的"}, {"from": 6400, "dur": 96, "text": "我找到的最清楚的例子，是香烟"}, {"from": 6500, "dur": 82, "text": "国际癌症研究机构 2011 年"}, {"from": 6587, "dur": 76, "text": "做过一次大范围的整理："}, {"from": 6668, "dur": 50, "text": "烟价每涨 10%"}, {"from": 6722, "dur": 82, "text": "总消费量只降 4% 到 5%"}, {"from": 6809, "dur": 69, "text": "这是一根很硬的铁丝"}, {"from": 6883, "dur": 89, "text": "所以各国政府都爱加烟草税"}, {"from": 6977, "dur": 76, "text": "涨多少，大部分人都留下"}, {"from": 7057, "dur": 50, "text": "税就收上来了"}, {"from": 7111, "dur": 82, "text": "但把这百分之四五拆开看"}, {"from": 7198, "dur": 56, "text": "就不是一个数了"}, {"from": 7259, "dur": 89, "text": "多份研究都给出同一个结论："}, {"from": 7353, "dur": 69, "text": "年轻人对烟价的反应"}, {"from": 7427, "dur": 69, "text": "是成年人的两到三倍；"}, {"from": 7501, "dur": 43, "text": "低收入的人"}, {"from": 7548, "dur": 82, "text": "也比高收入的人敏感得多"}, {"from": 7635, "dur": 102, "text": "你看，这就是上期那个问题的答案"}, {"from": 7742, "dur": 82, "text": "同一次涨价，老烟民是铁丝"}, {"from": 7829, "dur": 82, "text": "烟瘾在身上，又抽了二十年"}, {"from": 7916, "dur": 82, "text": "没有替代品，也没有时间换"}, {"from": 8003, "dur": 82, "text": "年轻人是橡皮筋，烟瘾还浅"}, {"from": 8090, "dur": 50, "text": "口袋里的钱少"}, {"from": 8144, "dur": 69, "text": "一包烟占预算的比例"}, {"from": 8218, "dur": 56, "text": "比成年人高得多"}, {"from": 8279, "dur": 96, "text": "于是一次加税，同时打中两种人："}, {"from": 8379, "dur": 69, "text": "留下的那批人多交税"}, {"from": 8453, "dur": 96, "text": "还没上瘾的那批人直接不开始"}, {"from": 8553, "dur": 96, "text": "说实话，我看明白这组数的时候"}, {"from": 8653, "dur": 82, "text": "才意识到上期贝恩报告里"}, {"from": 8740, "dur": 43, "text": "那 5000 万人"}, {"from": 8788, "dur": 89, "text": "为什么走得最多的是年轻人"}, {"from": 8881, "dur": 89, "text": "年轻人不是对奢侈品没兴趣"}, {"from": 8975, "dur": 109, "text": "只是对他们来说，那只包占预算太大"}, {"from": 9088, "dur": 50, "text": "替代品又太多"}, {"from": 9142, "dur": 96, "text": "一只香水、一个二手包，都能顶上"}, {"from": 9242, "dur": 41, "text": "还有一点"}, {"from": 9287, "dur": 96, "text": "弹性不是一个人身上固定的数"}, {"from": 9388, "dur": 43, "text": "Netflix 在 2011 年"}, {"from": 9435, "dur": 76, "text": "把流媒体和 DVD 拆开收费"}, {"from": 9516, "dur": 76, "text": "相当于一口气涨价 60%"}, {"from": 9596, "dur": 96, "text": "一个季度，美国用户走了 80 万"}, {"from": 9696, "dur": 76, "text": "股价从高点跌掉七成多"}, {"from": 9777, "dur": 69, "text": "2023 年底到 2025 年初"}, {"from": 9851, "dur": 69, "text": "它又连着涨了几次价"}, {"from": 9925, "dur": 69, "text": "这回用户没有往外跑："}, {"from": 9998, "dur": 76, "text": "2024 年全年净增 4100 万"}, {"from": 10079, "dur": 56, "text": "总数突破 3 亿"}, {"from": 10140, "dur": 76, "text": "同一家公司，同一个动作"}, {"from": 10220, "dur": 76, "text": "相差十几年，结果反过来"}, {"from": 10301, "dur": 96, "text": "变的不是用户的钱包，是替代品"}, {"from": 10401, "dur": 41, "text": "2011 年"}, {"from": 10446, "dur": 96, "text": "你随时可以退回录像带出租店"}, {"from": 10546, "dur": 56, "text": "或者看有线电视"}, {"from": 10607, "dur": 76, "text": "现在它已经是你的习惯"}, {"from": 10687, "dur": 63, "text": "每天要看两个小时"}, {"from": 10754, "dur": 63, "text": "想看的剧只有它有"}, {"from": 10822, "dur": 109, "text": "替代品一消失，橡皮筋就变成了铁丝"}, {"from": 10935, "dur": 96, "text": "要说清楚一点：弹性讲的是数量"}, {"from": 11035, "dur": 76, "text": "而商家真正在意的是钱"}, {"from": 11116, "dur": 76, "text": "涨价 10%，走了 4% 的人"}, {"from": 11196, "dur": 50, "text": "剩下 96% 的人"}, {"from": 11250, "dur": 50, "text": "每人多付 10%"}, {"from": 11305, "dur": 50, "text": "收入反而多了"}, {"from": 11359, "dur": 76, "text": "涨价 10%，走了 20% 的人"}, {"from": 11439, "dur": 41, "text": "那就亏了"}, {"from": 11484, "dur": 69, "text": "所以商家涨价前算的"}, {"from": 11558, "dur": 76, "text": "从来不是会不会有人走"}, {"from": 11639, "dur": 76, "text": "而是留下的人多付的钱"}, {"from": 11719, "dur": 96, "text": "够不够补上走掉的人带走的钱"}, {"from": 11819, "dur": 76, "text": "照这个账，海底捞涨 6%"}, {"from": 11900, "dur": 82, "text": "只要走掉的顾客不到 6%"}, {"from": 11987, "dur": 41, "text": "它就不亏"}, {"from": 12032, "dur": 76, "text": "我猜它当时真正害怕的"}, {"from": 12112, "dur": 102, "text": "是那张菜单在微博上传播的速度"}, {"from": 12219, "dur": 115, "text": "把这件事放到你自己身上，也一样好用"}, {"from": 12338, "dur": 63, "text": "下次收到涨价通知"}, {"from": 12406, "dur": 69, "text": "不管是视频会员、房租"}, {"from": 12480, "dur": 76, "text": "还是常去的那家理发店"}, {"from": 12560, "dur": 82, "text": "先别急着生气，问自己一句："}, {"from": 12647, "dur": 69, "text": "我有没有第二个选择"}, {"from": 12721, "dur": 56, "text": "有，你就是橡皮筋"}, {"from": 12782, "dur": 89, "text": "商家心里有数，不敢对你乱涨"}, {"from": 12875, "dur": 56, "text": "没有，你就是铁丝"}, {"from": 12936, "dur": 76, "text": "这次涨价，挑中的就是你"}, {"from": 13017, "dur": 96, "text": "商家要涨价，先挑的一定是铁丝"}, {"from": 13117, "dur": 96, "text": "所以不想被挑中，办法只有一个："}, {"from": 13217, "dur": 50, "text": "在它涨价之前"}, {"from": 13271, "dur": 89, "text": "先给自己准备好第二个选择"}, {"from": 13365, "dur": 89, "text": "回到 2020 年 4 月那张菜单"}, {"from": 13458, "dur": 69, "text": "一片土豆 1 块 5"}, {"from": 13532, "dur": 115, "text": "它让人生气的，其实不是那 1 块 5"}, {"from": 13652, "dur": 63, "text": "而是每个人都知道"}, {"from": 13719, "dur": 82, "text": "菜市场的土豆几块钱一斤"}, {"from": 13806, "dur": 56, "text": "替代品就在眼前"}, {"from": 13867, "dur": 82, "text": "所以这一次，顾客是橡皮筋"}, {"from": 13954, "dur": 69, "text": "海底捞看懂了这件事"}, {"from": 14028, "dur": 76, "text": "几天就把价格改了回去"}, {"from": 14108, "dur": 76, "text": "价格涨了，买的人会变少"}, {"from": 14189, "dur": 43, "text": "那卖的人呢"}, {"from": 14237, "dur": 76, "text": "下一期，我们聊供给定律"}], "source": "estimate"}