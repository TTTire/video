{"fps": 30, "total": 14691, "scenes": [{"scene": "menu", "from": 0, "dur": 600, "steps": [9, 63, 144, 224, 324, 372, 439, 533]}, {"scene": "sorry", "from": 600, "dur": 268, "steps": [0, 100, 187]}, {"scene": "wrongself", "from": 868, "dur": 541, "steps": [0, 93, 138, 245, 299, 406, 486]}, {"scene": "contrast", "from": 1409, "dur": 402, "steps": [0, 100, 193, 254, 335]}, {"scene": "direction0", "from": 1811, "dur": 287, "steps": [0, 87, 194]}, {"scene": "series", "from": 2098, "dur": 370, "steps": [0, 120, 200, 245, 319]}, {"scene": "chapter", "from": 2468, "dur": 66, "steps": [0], "chapter": 1, "title": "涨多少是一件事，留下多少是另一件"}, {"scene": "twothings", "from": 2534, "dur": 198, "steps": [0, 0, 105]}, {"scene": "define", "from": 2732, "dur": 910, "steps": [0, 81, 155, 268, 348, 462, 549, 668, 736, 810]}, {"scene": "attribute", "from": 3642, "dur": 755, "steps": [0, 113, 206, 267, 374, 454, 548, 661]}, {"scene": "comments", "from": 4397, "dur": 812, "steps": [0, 60, 180, 287, 354, 454, 528, 641, 728]}, {"scene": "chapter", "from": 5209, "dur": 66, "steps": [0], "chapter": 2, "title": "决定你是橡皮筋还是铁丝的三件事"}, {"scene": "door", "from": 5275, "dur": 355, "steps": [0, 0, 85, 166, 226, 274]}, {"scene": "three", "from": 5630, "dur": 387, "steps": [0, 93, 180, 274]}, {"scene": "budget", "from": 6017, "dur": 335, "steps": [0, 100, 174, 281]}, {"scene": "time", "from": 6352, "dur": 267, "steps": [0, 67, 161]}, {"scene": "notonmenu", "from": 6619, "dur": 283, "steps": [0, 61, 135, 183]}, {"scene": "tobacco", "from": 6902, "dur": 893, "steps": [0, 100, 167, 241, 296, 350, 411, 485, 565, 645, 739, 826]}, {"scene": "split", "from": 7795, "dur": 368, "steps": [0, 100, 174, 248]}, {"scene": "two", "from": 8163, "dur": 770, "steps": [0, 87, 174, 261, 322, 402, 496, 596, 670]}, {"scene": "bain", "from": 8933, "dur": 518, "steps": [0, 93, 167, 261, 361, 415]}, {"scene": "chapter", "from": 9451, "dur": 66, "steps": [0], "chapter": 3, "title": "同一家公司，为什么两次结果相反"}, {"scene": "netflix2011", "from": 9517, "dur": 466, "steps": [0, 0, 76, 124, 205, 285, 385]}, {"scene": "netflix2025", "from": 9983, "dur": 517, "steps": [0, 74, 147, 215, 295, 356, 437]}, {"scene": "substitute", "from": 10500, "dur": 552, "steps": [0, 54, 122, 189, 250, 304, 391, 445]}, {"scene": "revenue", "from": 11052, "dur": 759, "steps": [0, 80, 141, 196, 256, 311, 391, 478, 572, 659]}, {"scene": "guess", "from": 11811, "dur": 248, "steps": [0, 80, 141]}, {"scene": "self", "from": 12059, "dur": 891, "steps": [0, 113, 180, 254, 335, 422, 495, 582, 637, 698, 778]}, {"scene": "prepare", "from": 12950, "dur": 729, "steps": [0, 94, 200, 320, 394, 494, 581, 662]}, {"scene": "potato", "from": 13679, "dur": 744, "steps": [0, 93, 167, 287, 354, 441, 502, 589, 663]}, {"scene": "next", "from": 14423, "dur": 268, "steps": [0, 80, 128]}], "subs": [{"from": 9, "dur": 50, "text": "2020 年 4 月"}, {"from": 63, "dur": 76, "text": "北京一位顾客在微博上"}, {"from": 144, "dur": 76, "text": "晒了一张海底捞的菜单"}, {"from": 224, "dur": 96, "text": "血旺半份，从 16 块涨到 23 块"}, {"from": 324, "dur": 43, "text": "一共八小片"}, {"from": 372, "dur": 63, "text": "半份土豆片 13 块"}, {"from": 439, "dur": 89, "text": "算下来一片土豆 1 块 5"}, {"from": 533, "dur": 63, "text": "米饭 7 块钱一碗"}, {"from": 600, "dur": 96, "text": "几天后，海底捞发了一封致歉信"}, {"from": 700, "dur": 82, "text": "说这是管理层的错误决策"}, {"from": 787, "dur": 76, "text": "价格全部恢复到停业前"}, {"from": 868, "dur": 89, "text": "我第一反应也和评论区一样："}, {"from": 961, "dur": 41, "text": "涨得离谱"}, {"from": 1006, "dur": 102, "text": "这几天我把 2020 年 4 月的报道"}, {"from": 1113, "dur": 50, "text": "重新翻出来看"}, {"from": 1167, "dur": 102, "text": "才发现我一开始就记错了一件事"}, {"from": 1274, "dur": 76, "text": "海底捞当时的整体涨幅"}, {"from": 1354, "dur": 50, "text": "其实只有 6%"}, {"from": 1409, "dur": 96, "text": "上一期我们刚看过另一支队伍"}, {"from": 1509, "dur": 89, "text": "奢侈品一年涨两次，每次 10%"}, {"from": 1602, "dur": 56, "text": "门口照样排长队"}, {"from": 1663, "dur": 76, "text": "6% 的火锅被骂到道歉"}, {"from": 1744, "dur": 63, "text": "10% 的包越涨越抢"}, {"from": 1811, "dur": 82, "text": "贵不贵，不是这期要讲的事"}, {"from": 1898, "dur": 102, "text": "说实话，这两个数摆在一起的时候"}, {"from": 2005, "dur": 89, "text": "我才意识到自己想错了方向"}, {"from": 2098, "dur": 115, "text": "这里是像素呼吸的《100个经济学原理》"}, {"from": 2218, "dur": 76, "text": "第 8 个，需求价格弹性"}, {"from": 2298, "dur": 40, "text": "不背概念"}, {"from": 2343, "dur": 69, "text": "只用生活里的一笔账"}, {"from": 2417, "dur": 43, "text": "把它讲明白"}, {"from": 2465, "dur": 63, "text": "涨了多少，是一件事"}, {"from": 2532, "dur": 102, "text": "涨完还有多少人留下，是另一件事"}, {"from": 2639, "dur": 89, "text": "这两件事，经济学是分开算的"}, {"from": 2732, "dur": 76, "text": "先把这个词翻译成人话："}, {"from": 2813, "dur": 69, "text": "需求价格弹性说的是"}, {"from": 2887, "dur": 109, "text": "价格动一下，你买的数量跟着动多少"}, {"from": 3000, "dur": 76, "text": "价格涨 10%，你少买 20%"}, {"from": 3080, "dur": 109, "text": "这叫弹性大，像一根橡皮筋，一拉就长"}, {"from": 3194, "dur": 82, "text": "价格涨 10%，你只少买 2%"}, {"from": 3281, "dur": 115, "text": "这叫弹性小，像一根铁丝，怎么拉都不动"}, {"from": 3400, "dur": 63, "text": "上一期的需求定律"}, {"from": 3468, "dur": 69, "text": "只说了方向：贵了少买"}, {"from": 3542, "dur": 96, "text": "弹性说的是幅度：到底少买多少"}, {"from": 3642, "dur": 109, "text": "这两个数都是示意，不对应具体商品"}, {"from": 3755, "dur": 89, "text": "但大多数人真正卡住的地方"}, {"from": 3848, "dur": 56, "text": "不是算不清幅度"}, {"from": 3909, "dur": 102, "text": "而是把弹性当成东西自带的属性"}, {"from": 4016, "dur": 76, "text": "盐是铁丝，火锅是橡皮筋"}, {"from": 4096, "dur": 89, "text": "奢侈品是铁丝，奶茶是橡皮筋"}, {"from": 4190, "dur": 109, "text": "照这个说法，海底捞道歉就很好解释："}, {"from": 4303, "dur": 89, "text": "火锅本来就是橡皮筋，涨不得"}, {"from": 4397, "dur": 56, "text": "这话听着特别顺"}, {"from": 4457, "dur": 115, "text": "可你回想一下那张菜单下面的评论区"}, {"from": 4577, "dur": 102, "text": "同样是看到一片土豆 1 块 5"}, {"from": 4684, "dur": 63, "text": "有人说“再也不去了”"}, {"from": 4751, "dur": 96, "text": "也有人说“又不是天天吃，无所谓”"}, {"from": 4851, "dur": 69, "text": "同一家店，同一张菜单"}, {"from": 4925, "dur": 109, "text": "一部分人是橡皮筋，一部分人是铁丝"}, {"from": 5038, "dur": 82, "text": "所以弹性不长在火锅身上"}, {"from": 5125, "dur": 76, "text": "它长在吃火锅的人身上"}, {"from": 5206, "dur": 50, "text": "那到底是什么"}, {"from": 5260, "dur": 96, "text": "决定一个人是橡皮筋还是铁丝"}, {"from": 5360, "dur": 76, "text": "说到底，决定你走不走的"}, {"from": 5441, "dur": 56, "text": "不是桌上那道菜"}, {"from": 5501, "dur": 43, "text": "是推门出去"}, {"from": 5549, "dur": 76, "text": "还有没有别的地方可去"}, {"from": 5630, "dur": 89, "text": "顺着这句话往下拆，是三件事"}, {"from": 5723, "dur": 82, "text": "第一，有没有别的地方可去"}, {"from": 5810, "dur": 89, "text": "海底捞楼下就有十家火锅店"}, {"from": 5904, "dur": 109, "text": "而上一期那只包，只有专柜才买得到"}, {"from": 6017, "dur": 96, "text": "第二，这笔钱占你口袋多大一块"}, {"from": 6117, "dur": 69, "text": "人均两百多的一顿饭"}, {"from": 6191, "dur": 102, "text": "对月薪五千的人和月薪五万的人"}, {"from": 6298, "dur": 50, "text": "不是同一笔钱"}, {"from": 6352, "dur": 63, "text": "第三，有没有时间换"}, {"from": 6419, "dur": 89, "text": "今天晚上就要请客，你只能认；"}, {"from": 6513, "dur": 102, "text": "下个月再聚，你有的是时间挑别家"}, {"from": 6619, "dur": 56, "text": "替代品、预算、时间"}, {"from": 6680, "dur": 69, "text": "没有一样写在菜单上"}, {"from": 6754, "dur": 43, "text": "那这三件事"}, {"from": 6802, "dur": 96, "text": "在一群人身上怎么同时起作用"}, {"from": 6902, "dur": 96, "text": "我找到的最清楚的例子，是香烟"}, {"from": 7002, "dur": 63, "text": "国际癌症研究机构"}, {"from": 7069, "dur": 69, "text": "2011 年做过一次整理："}, {"from": 7143, "dur": 50, "text": "烟价每涨 10%"}, {"from": 7198, "dur": 50, "text": "总消费量大概"}, {"from": 7252, "dur": 56, "text": "只降 4% 到 5%"}, {"from": 7313, "dur": 69, "text": "翻成刚才那句话就是："}, {"from": 7387, "dur": 76, "text": "香烟是一根很硬的铁丝"}, {"from": 7467, "dur": 76, "text": "涨多少，大部分人都留下"}, {"from": 7547, "dur": 89, "text": "所以各国政府都爱加烟草税"}, {"from": 7641, "dur": 82, "text": "但把这百分之四五拆开看"}, {"from": 7728, "dur": 63, "text": "它就不是一个数了"}, {"from": 7795, "dur": 96, "text": "多份研究给出的是同一个结论："}, {"from": 7895, "dur": 69, "text": "年轻人对烟价的反应"}, {"from": 7969, "dur": 69, "text": "是成年人的两到三倍"}, {"from": 8043, "dur": 115, "text": "低收入的人，也比高收入的人敏感得多"}, {"from": 8163, "dur": 82, "text": "同一次涨价，老烟民是铁丝"}, {"from": 8250, "dur": 82, "text": "烟瘾在身上，又抽了二十年"}, {"from": 8337, "dur": 82, "text": "没有替代品，也没有时间换"}, {"from": 8424, "dur": 56, "text": "年轻人是橡皮筋"}, {"from": 8485, "dur": 76, "text": "烟瘾还浅，口袋里的钱少"}, {"from": 8565, "dur": 89, "text": "一包烟占预算的比例高得多"}, {"from": 8659, "dur": 96, "text": "于是一次加税，同时打中两种人："}, {"from": 8759, "dur": 69, "text": "留下的那批人多交税"}, {"from": 8833, "dur": 96, "text": "还没上瘾的那批人，直接不开始"}, {"from": 8933, "dur": 89, "text": "说实话，看到这组数我才明白"}, {"from": 9026, "dur": 69, "text": "上一期那 5000 万人里"}, {"from": 9100, "dur": 89, "text": "为什么走得最多的是年轻人"}, {"from": 9194, "dur": 96, "text": "对他们来说，那只包占预算太大"}, {"from": 9294, "dur": 50, "text": "替代品又太多"}, {"from": 9348, "dur": 96, "text": "一瓶香水、一个二手包，都能顶上"}, {"from": 9448, "dur": 41, "text": "还有一点"}, {"from": 9493, "dur": 96, "text": "弹性不是一个人身上固定的数"}, {"from": 9593, "dur": 43, "text": "Netflix 在 2011 年"}, {"from": 9641, "dur": 76, "text": "把流媒体和 DVD 拆开收费"}, {"from": 9722, "dur": 76, "text": "相当于一口气涨价 60%"}, {"from": 9802, "dur": 96, "text": "一个季度，美国走了 80 万用户"}, {"from": 9902, "dur": 76, "text": "股价从高点跌掉七成多"}, {"from": 9983, "dur": 69, "text": "2023 年底到 2025 年初"}, {"from": 10057, "dur": 69, "text": "它又连着涨了几次价"}, {"from": 10130, "dur": 63, "text": "这回用户没往外跑"}, {"from": 10198, "dur": 76, "text": "2024 年全年净增 4100 万"}, {"from": 10278, "dur": 56, "text": "总数突破 3 亿"}, {"from": 10339, "dur": 76, "text": "同一家公司，同一个动作"}, {"from": 10420, "dur": 76, "text": "隔了十几年，结果反过来"}, {"from": 10500, "dur": 50, "text": "变的是替代品"}, {"from": 10554, "dur": 63, "text": "2011 年你随时可以"}, {"from": 10622, "dur": 63, "text": "退回录像带出租店"}, {"from": 10689, "dur": 56, "text": "或者看有线电视"}, {"from": 10750, "dur": 50, "text": "今天它占掉的"}, {"from": 10804, "dur": 82, "text": "是你每天两个小时的习惯"}, {"from": 10891, "dur": 50, "text": "剧只有它家有"}, {"from": 10945, "dur": 102, "text": "替代品一消失，橡皮筋就变成铁丝"}, {"from": 11052, "dur": 76, "text": "再把这件事放大一点看"}, {"from": 11132, "dur": 56, "text": "弹性讲的是数量"}, {"from": 11193, "dur": 50, "text": "商家算的是钱"}, {"from": 11248, "dur": 56, "text": "涨 10%，只走 4%"}, {"from": 11308, "dur": 50, "text": "收入反而多了"}, {"from": 11363, "dur": 76, "text": "涨 10%，走了 20%，就是亏"}, {"from": 11443, "dur": 82, "text": "所以海底捞涨 6% 的时候"}, {"from": 11530, "dur": 89, "text": "它算的是留下的人多付的钱"}, {"from": 11624, "dur": 82, "text": "够不够补上走掉的那批人"}, {"from": 11711, "dur": 96, "text": "只要走掉的不到 6%，它就不亏"}, {"from": 11811, "dur": 76, "text": "我猜它当时真正害怕的"}, {"from": 11891, "dur": 56, "text": "不是走掉几个点"}, {"from": 11952, "dur": 102, "text": "是那张菜单在微博上传开的速度"}, {"from": 12059, "dur": 109, "text": "放到你自己身上，这件事也一样好用"}, {"from": 12172, "dur": 63, "text": "下次收到涨价通知"}, {"from": 12239, "dur": 69, "text": "不管是视频会员、房租"}, {"from": 12313, "dur": 76, "text": "还是常去的那家理发店"}, {"from": 12394, "dur": 82, "text": "先别急着生气，问自己一句："}, {"from": 12481, "dur": 69, "text": "我有没有第二个选择"}, {"from": 12554, "dur": 82, "text": "有，你走得动，商家心里有数"}, {"from": 12641, "dur": 50, "text": "不敢对你乱涨"}, {"from": 12696, "dur": 56, "text": "没有，你就是铁丝"}, {"from": 12757, "dur": 76, "text": "这次涨价，挑中的就是你"}, {"from": 12837, "dur": 109, "text": "因为商家要涨价，先挑的一定是铁丝"}, {"from": 12950, "dur": 89, "text": "这回写完，我打算做一件小事："}, {"from": 13044, "dur": 102, "text": "把每个月自动扣款的东西列一遍"}, {"from": 13150, "dur": 115, "text": "一个一个问自己，我有没有第二个选择"}, {"from": 13270, "dur": 69, "text": "最舍不得退的那几个"}, {"from": 13344, "dur": 96, "text": "恰恰是我找不到第二个的那种"}, {"from": 13444, "dur": 82, "text": "我到现在还没想清楚的是"}, {"from": 13531, "dur": 76, "text": "这是它们真的值这个钱"}, {"from": 13612, "dur": 63, "text": "还是我懒得去找了"}, {"from": 13679, "dur": 89, "text": "回到 2020 年 4 月那张菜单"}, {"from": 13772, "dur": 69, "text": "一片土豆 1 块 5"}, {"from": 13846, "dur": 115, "text": "让人生气的其实轮不到那 1 块 5"}, {"from": 13966, "dur": 63, "text": "而是每个人都知道"}, {"from": 14033, "dur": 82, "text": "菜市场的土豆几块钱一斤"}, {"from": 14120, "dur": 56, "text": "替代品就在眼前"}, {"from": 14181, "dur": 82, "text": "所以这一次，顾客是橡皮筋"}, {"from": 14268, "dur": 69, "text": "海底捞看懂了这件事"}, {"from": 14342, "dur": 76, "text": "几天就把价格改了回去"}, {"from": 14423, "dur": 76, "text": "价格涨了，买的人会变少"}, {"from": 14503, "dur": 43, "text": "那卖的人呢"}, {"from": 14551, "dur": 76, "text": "下一期，我们聊供给定律"}], "source": "estimate"}