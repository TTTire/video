{"fps": 30, "total": 10814, "scenes": [{"scene": "open", "from": 0, "dur": 358, "steps": [0]}, {"scene": "resign", "from": 358, "dur": 328, "steps": [0]}, {"scene": "petition", "from": 686, "dur": 303, "steps": [0]}, {"scene": "earnings", "from": 989, "dur": 339, "steps": [0]}, {"scene": "doubt", "from": 1328, "dur": 195, "steps": [0]}, {"scene": "hook", "from": 1523, "dur": 224, "steps": [0]}, {"scene": "title", "from": 1747, "dur": 150, "steps": [0]}, {"scene": "chapter", "from": 1897, "dur": 66, "steps": [0], "chapter": 1, "title": "他走的那两周，什么变了"}, {"scene": "timeline", "from": 1963, "dur": 402, "steps": [0]}, {"scene": "myth", "from": 2365, "dur": 399, "steps": [0]}, {"scene": "drop", "from": 2764, "dur": 369, "steps": [0]}, {"scene": "numbers", "from": 3133, "dur": 472, "steps": [0]}, {"scene": "board", "from": 3605, "dur": 403, "steps": [0]}, {"scene": "split", "from": 4008, "dur": 289, "steps": [0]}, {"scene": "chapter", "from": 4297, "dur": 66, "steps": [0], "chapter": 2, "title": "报表上没写的那一栏"}, {"scene": "assets", "from": 4363, "dur": 315, "steps": [0]}, {"scene": "price", "from": 4678, "dur": 386, "steps": [0]}, {"scene": "keyrisk", "from": 5064, "dur": 585, "steps": [0]}, {"scene": "jobs", "from": 5649, "dur": 221, "steps": [0]}, {"scene": "switch", "from": 5870, "dur": 657, "steps": [0]}, {"scene": "network", "from": 6527, "dur": 497, "steps": [0]}, {"scene": "yang", "from": 7024, "dur": 534, "steps": [0]}, {"scene": "worth", "from": 7558, "dur": 336, "steps": [0]}, {"scene": "chapter", "from": 7894, "dur": 66, "steps": [0], "chapter": 3, "title": "离不开一个人，是护城河还是软肋"}, {"scene": "reverse", "from": 7960, "dur": 151, "steps": [0]}, {"scene": "badnews", "from": 8111, "dur": 362, "steps": [0]}, {"scene": "board2", "from": 8473, "dur": 327, "steps": [0]}, {"scene": "callback", "from": 8800, "dur": 379, "steps": [0]}, {"scene": "ordinary", "from": 9179, "dur": 374, "steps": [0]}, {"scene": "invest", "from": 9553, "dur": 425, "steps": [0]}, {"scene": "proof", "from": 9978, "dur": 201, "steps": [0]}, {"scene": "moat", "from": 10179, "dur": 635, "steps": [0]}], "points": {"0.1": 0, "0.2": 358, "0.3": 686, "0.4": 989, "0.5": 1328, "0.6": 1523, "0.7": 1747, "1.0": 1897, "1.1": 1963, "1.2": 2365, "1.3": 2764, "1.4": 3133, "1.5": 3605, "1.6": 4008, "2.0": 4297, "2.1": 4363, "2.2": 4678, "2.3": 5064, "2.4": 5649, "2.5": 5870, "2.6": 6527, "2.7": 7024, "2.8": 7558, "3.0": 7894, "3.1": 7960, "3.2": 8111, "3.3": 8473, "3.4": 8800, "3.5": 9179, "3.6": 9553, "3.7": 9978, "3.8": 10179}, "subs": [{"from": 1, "dur": 58, "text": "11月23号 美股开盘"}, {"from": 71, "dur": 64, "text": "英伟达的股价暴涨了30%"}, {"from": 149, "dur": 30, "text": "不是发了新的芯片"}, {"from": 181, "dur": 43, "text": "也不是财报超了预期"}, {"from": 239, "dur": 47, "text": "而是一个辞职了不久的人"}, {"from": 300, "dur": 48, "text": "被董事会延请回来了"}, {"from": 359, "dur": 34, "text": "11月12号"}, {"from": 394, "dur": 77, "text": "黄仁勋辞去英伟达CEO的董事职务"}, {"from": 484, "dur": 79, "text": "CFO科莱特·克雷斯临时接棒"}, {"from": 576, "dur": 45, "text": "公司成立33年以来"}, {"from": 635, "dur": 40, "text": "第一次没有他的名字"}, {"from": 688, "dur": 79, "text": "那周 英伟达的股价暴跌了14%"}, {"from": 779, "dur": 47, "text": "要求他复职请愿的签名"}, {"from": 842, "dur": 58, "text": "从11万左右涨到18万"}, {"from": 912, "dur": 67, "text": "里面有几千人自称是英伟达的员工"}, {"from": 991, "dur": 71, "text": "更别扭的是 11月17号的财报"}, {"from": 1075, "dur": 49, "text": "营收1158亿美元"}, {"from": 1139, "dur": 46, "text": "净利润653个亿"}, {"from": 1196, "dur": 31, "text": "订单一个都没少"}, {"from": 1239, "dur": 77, "text": "董事会当天却说 无意让他复职"}, {"from": 1329, "dur": 29, "text": "第一反应多半是"}, {"from": 1372, "dur": 69, "text": "这不就是创始人的光环 人情戏吗"}, {"from": 1457, "dur": 55, "text": "这跟经济学又有什么关系呢"}, {"from": 1525, "dur": 27, "text": "可市场的反应"}, {"from": 1553, "dur": 79, "text": "却不会给人情戏30%的增幅"}, {"from": 1644, "dur": 23, "text": "它其实是在给"}, {"from": 1669, "dur": 68, "text": "一样报表上不写的东西定价"}, {"from": 1749, "dur": 31, "text": "这里是像素呼吸"}, {"from": 1792, "dur": 42, "text": "今天我们一起聊一聊"}, {"from": 1835, "dur": 58, "text": "一家公司为什么离不开一个人"}, {"from": 1926, "dur": 50, "text": "我们先把时间线理齐"}, {"from": 1989, "dur": 55, "text": "11月12号 黄仁勋辞任"}, {"from": 2056, "dur": 41, "text": "克雷斯临时接管"}, {"from": 2098, "dur": 62, "text": "前某公司的CEO哈维·琼斯"}, {"from": 2174, "dur": 55, "text": "出任公司史上第一位董事长"}, {"from": 2244, "dur": 59, "text": "公司说 我们的路线图不变"}, {"from": 2320, "dur": 36, "text": "我们的合同也不会断"}, {"from": 2367, "dur": 46, "text": "其实我以前也是这样想的"}, {"from": 2425, "dur": 60, "text": "一家全球市值最大的芯片公司"}, {"from": 2486, "dur": 85, "text": "靠的一定是产品和客户的粘性"}, {"from": 2589, "dur": 65, "text": "以及专利 而不是某一个人"}, {"from": 2668, "dur": 85, "text": "制度应该比某一个人的名声更可靠"}, {"from": 2765, "dur": 60, "text": "可市场没空等你的消息"}, {"from": 2839, "dur": 62, "text": "那周的股价暴跌了14%"}, {"from": 2913, "dur": 44, "text": "请黄仁勋复出的签名"}, {"from": 2959, "dur": 56, "text": "从11万涨到了18万"}, {"from": 3032, "dur": 27, "text": "财报还没出"}, {"from": 3060, "dur": 73, "text": "大家已经先用脚去投票了"}, {"from": 3134, "dur": 56, "text": "11月17号财报出了之后"}, {"from": 3202, "dur": 24, "text": "数字很僵硬"}, {"from": 3240, "dur": 59, "text": "总营收1158个亿"}, {"from": 3312, "dur": 57, "text": "同比增长了103%"}, {"from": 3371, "dur": 44, "text": "数据中心一个季度的营收"}, {"from": 3417, "dur": 64, "text": "也达到了1076个亿"}, {"from": 3482, "dur": 66, "text": "四季度的指引大约1300亿"}, {"from": 3562, "dur": 32, "text": "订单一个都没少"}, {"from": 3607, "dur": 29, "text": "但同一个电话会上"}, {"from": 3638, "dur": 69, "text": "董事长却说无意让他复职"}, {"from": 3718, "dur": 89, "text": "还新设立了一个出口管制监督委员会"}, {"from": 3821, "dur": 54, "text": "那么他们究竟怕的是什么呢"}, {"from": 3889, "dur": 27, "text": "其实不是业绩"}, {"from": 3932, "dur": 65, "text": "而是要让公司的一切东西都合规"}, {"from": 4010, "dur": 87, "text": "业绩可以证明整个公司是可以转起来的"}, {"from": 4113, "dur": 51, "text": "股价和请愿证明"}, {"from": 4176, "dur": 55, "text": "人不在了 但是大家不相信"}, {"from": 4248, "dur": 45, "text": "这两件事同时成立"}, {"from": 4321, "dur": 68, "text": "其实从会计的角度来看"}, {"from": 4400, "dur": 79, "text": "一家公司的资产是厂房 设备"}, {"from": 4481, "dur": 73, "text": "专利 现金 以及商誉"}, {"from": 4567, "dur": 66, "text": "那么人会写进资产负债表里吗"}, {"from": 4652, "dur": 21, "text": "确实不会"}, {"from": 4680, "dur": 46, "text": "但市场会认这个东西"}, {"from": 4737, "dur": 26, "text": "11月23号"}, {"from": 4764, "dur": 79, "text": "董事会一致决定恢复他的职务"}, {"from": 4856, "dur": 92, "text": "消息一出来 开盘就涨了约30%"}, {"from": 4965, "dur": 37, "text": "这不是给财报的"}, {"from": 5014, "dur": 39, "text": "而是给他回来的礼物"}, {"from": 5066, "dur": 76, "text": "经济学里有一个词 叫关键人风险"}, {"from": 5158, "dur": 76, "text": "一家公司的价值过度依赖某一个人"}, {"from": 5249, "dur": 32, "text": "翻译一下其实就是"}, {"from": 5300, "dur": 61, "text": "这个人的判断 关系 声望"}, {"from": 5373, "dur": 53, "text": "已经变成了公司资产的一部分"}, {"from": 5444, "dur": 54, "text": "而这块我的理解也不是很深"}, {"from": 5510, "dur": 21, "text": "讲得不对的地方"}, {"from": 5533, "dur": 64, "text": "还请大家在评论区指出来"}, {"from": 5611, "dur": 24, "text": "我们一起学习"}, {"from": 5651, "dur": 51, "text": "我先让AI去调研了一圈"}, {"from": 5716, "dur": 61, "text": "把这两周的公告和报道捋了一遍"}, {"from": 5792, "dur": 62, "text": "又翻了一个老案例 那就是乔布斯"}, {"from": 5874, "dur": 57, "text": "1985年他离开苹果"}, {"from": 5933, "dur": 42, "text": "直到97年才回来"}, {"from": 5989, "dur": 31, "text": "中间隔了12年"}, {"from": 6037, "dur": 67, "text": "苹果的市场价掉到了3%左右"}, {"from": 6119, "dur": 76, "text": "1996年 一年就亏掉了15亿美元"}, {"from": 6211, "dur": 44, "text": "当时市场每周都在猜"}, {"from": 6266, "dur": 41, "text": "究竟是谁会把它买走"}, {"from": 6319, "dur": 33, "text": "而人还是那个人"}, {"from": 6364, "dur": 35, "text": "公司还是那家公司"}, {"from": 6412, "dur": 51, "text": "差的从来都不是那个产品"}, {"from": 6476, "dur": 51, "text": "而是究竟是谁在拍板"}, {"from": 6529, "dur": 68, "text": "其实英伟达也一样 过去33年"}, {"from": 6610, "dur": 35, "text": "对华的产品怎么做"}, {"from": 6658, "dur": 41, "text": "跟监管机构怎么谈"}, {"from": 6712, "dur": 46, "text": "给哪些客户优先供货"}, {"from": 6772, "dur": 88, "text": "很多决定靠的是他个人的判断和关系网"}, {"from": 6874, "dur": 65, "text": "这些东西根本不会写在报表里"}, {"from": 6953, "dur": 71, "text": "但市场却每天都在给它定价"}, {"from": 7026, "dur": 57, "text": "这让我想到之前在北大创投课"}, {"from": 7084, "dur": 42, "text": "有一位老师讲的识人"}, {"from": 7139, "dur": 42, "text": "他说创业早期最贵的"}, {"from": 7183, "dur": 67, "text": "不是融资时估值很低"}, {"from": 7265, "dur": 52, "text": "而是关键的位置放错了人"}, {"from": 7336, "dur": 75, "text": "核心人才比资金杠杆更底层"}, {"from": 7428, "dur": 58, "text": "因为人决定了资金的去向"}, {"from": 7502, "dur": 56, "text": "我当时也是双手赞成的"}, {"from": 7559, "dur": 35, "text": "最终我的总结是"}, {"from": 7610, "dur": 59, "text": "一家公司最值钱的资产"}, {"from": 7671, "dur": 59, "text": "有时候只是一个人的判断力"}, {"from": 7741, "dur": 62, "text": "它从不在资产负债表上体现"}, {"from": 7818, "dur": 71, "text": "但在股价里 我们可以看到它的踪影"}, {"from": 7918, "dur": 48, "text": "那么我们反过来问一句"}, {"from": 7977, "dur": 43, "text": "一家公司离不开一个人"}, {"from": 8022, "dur": 89, "text": "对股东到底是好事还是坏事呢"}, {"from": 8113, "dur": 67, "text": "好消息是 这个人的判断还在"}, {"from": 8181, "dur": 47, "text": "那么公司的魂就还在"}, {"from": 8243, "dur": 52, "text": "但坏消息是 他总会走"}, {"from": 8309, "dur": 79, "text": "而且这次是被调查辞职再请回"}, {"from": 8404, "dur": 68, "text": "说明制度根本不能独立运转"}, {"from": 8474, "dur": 73, "text": "董事会进行的先拒绝后请回"}, {"from": 8548, "dur": 51, "text": "中间虽然只隔六天"}, {"from": 8618, "dur": 25, "text": "但我的理解是"}, {"from": 8644, "dur": 76, "text": "这不是一笔纯粹的商业决策"}, {"from": 8734, "dur": 66, "text": "而是治理在给个人让路"}, {"from": 8801, "dur": 53, "text": "前面说北大老师讲了"}, {"from": 8866, "dur": 81, "text": "关键位置放错人 这个决策最贵"}, {"from": 8959, "dur": 56, "text": "英伟达这里却是反过来"}, {"from": 9016, "dur": 47, "text": "关键位置放对了人"}, {"from": 9076, "dur": 32, "text": "而公司离不开他"}, {"from": 9119, "dur": 51, "text": "这也是一个非常致命的风险"}, {"from": 9181, "dur": 25, "text": "对普通人来说"}, {"from": 9222, "dur": 42, "text": "你公司里那个一走"}, {"from": 9265, "dur": 56, "text": "就导致整个公司转不动的人"}, {"from": 9337, "dur": 61, "text": "是资产 同样也是最大的风险"}, {"from": 9412, "dur": 23, "text": "而对你自己"}, {"from": 9451, "dur": 59, "text": "成为那个人就是你的安全感"}, {"from": 9520, "dur": 33, "text": "也是你的天花板"}, {"from": 9555, "dur": 32, "text": "而对投资来说"}, {"from": 9588, "dur": 78, "text": "买一家公司除了去看它的财报"}, {"from": 9667, "dur": 22, "text": "它的业务"}, {"from": 9700, "dur": 70, "text": "还要去看当这个公司的决策人"}, {"from": 9772, "dur": 34, "text": "走了之后会怎么样"}, {"from": 9826, "dur": 45, "text": "继任计划 治理结构"}, {"from": 9885, "dur": 36, "text": "关键人依赖程度"}, {"from": 9933, "dur": 35, "text": "都是我们要决策的点"}, {"from": 9980, "dur": 89, "text": "英伟达这次证明了它离不开它的创始人"}, {"from": 10082, "dur": 55, "text": "也证明了其实它也没有找到"}, {"from": 10139, "dur": 41, "text": "一个更好的继承人"}, {"from": 10181, "dur": 32, "text": "而真正的护城河是"}, {"from": 10215, "dur": 68, "text": "这个项目 这个公司离了谁都能转"}, {"from": 10306, "dur": 28, "text": "真正的溢价是"}, {"from": 10347, "dur": 54, "text": "离了谁就变成不一样的东西"}, {"from": 10415, "dur": 49, "text": "这两句话同时成立"}, {"from": 10466, "dur": 26, "text": "才是最难的事情"}, {"from": 10507, "dur": 65, "text": "如果你就是公司里那个不能走的人"}, {"from": 10588, "dur": 27, "text": "这到底是好事"}, {"from": 10628, "dur": 62, "text": "还是你早点想办法的事情呢"}, {"from": 10700, "dur": 50, "text": "这个问题留给大家一起回答"}], "source": "starts"}