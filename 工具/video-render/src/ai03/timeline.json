{"fps": 30, "total": 14452, "scenes": [{"scene": "news", "from": 0, "dur": 535, "steps": [7, 30, 133, 187, 263, 292, 338, 383, 452]}, {"scene": "doubt", "from": 535, "dur": 758, "steps": [0, 66, 113, 198, 243, 296, 357, 422, 450, 519, 607, 660, 691]}, {"scene": "hook", "from": 1293, "dur": 370, "steps": [0, 48, 126, 169, 218, 269, 315]}, {"scene": "chapter", "from": 1663, "dur": 66, "steps": [0], "chapter": 1, "title": "便宜了，为什么旁边会变贵"}, {"scene": "same", "from": 1729, "dur": 676, "steps": [0, 0, 64, 122, 168, 228, 273, 325, 386, 439, 477, 551, 578]}, {"scene": "street", "from": 2405, "dur": 420, "steps": [0, 56, 146, 219, 266, 303]}, {"scene": "pair", "from": 2825, "dur": 196, "steps": [0, 69, 119]}, {"scene": "hometown", "from": 3021, "dur": 522, "steps": [0, 52, 124, 187, 252, 332, 424]}, {"scene": "hsrdata", "from": 3543, "dur": 381, "steps": [0, 40, 110, 148, 221, 319]}, {"scene": "crowd", "from": 3924, "dur": 405, "steps": [0, 79, 156, 218, 304, 345]}, {"scene": "solarpv", "from": 4329, "dur": 299, "steps": [0, 42, 110, 182, 238]}, {"scene": "grid", "from": 4628, "dur": 462, "steps": [0, 71, 95, 161, 197, 294, 358]}, {"scene": "squeeze", "from": 5090, "dur": 353, "steps": [0, 39, 86, 161, 233, 290]}, {"scene": "chapter", "from": 5443, "dur": 66, "steps": [0], "chapter": 2, "title": "一百年前，电也这么“没用”过"}, {"scene": "edison", "from": 5509, "dur": 270, "steps": [0, 8, 67, 165, 221]}, {"scene": "flat", "from": 5779, "dur": 390, "steps": [0, 55, 142, 220, 292]}, {"scene": "lineframe", "from": 6169, "dur": 732, "steps": [0, 37, 86, 191, 278, 343, 431, 489, 582, 652]}, {"scene": "groupdrive", "from": 6901, "dur": 548, "steps": [0, 52, 112, 161, 224, 307, 387, 439]}, {"scene": "waste", "from": 7449, "dur": 359, "steps": [0, 70, 178, 210, 263]}, {"scene": "unitdrive", "from": 7808, "dur": 493, "steps": [0, 39, 110, 194, 240, 349, 393, 446]}, {"scene": "forty", "from": 8301, "dur": 337, "steps": [0, 56, 128, 169, 240, 296]}, {"scene": "invest", "from": 8638, "dur": 426, "steps": [0, 48, 140, 236, 271, 320]}, {"scene": "numbers", "from": 9064, "dur": 572, "steps": [0, 50, 135, 205, 254, 339, 434, 468]}, {"scene": "rearrange", "from": 9636, "dur": 400, "steps": [0, 26, 107, 187, 213, 260, 331]}, {"scene": "invoice", "from": 10036, "dur": 412, "steps": [0, 67, 112, 206, 251, 299, 342]}, {"scene": "chapter", "from": 10448, "dur": 66, "steps": [0], "chapter": 3, "title": "那今天变贵的是哪一样"}, {"scene": "todaysmap", "from": 10514, "dur": 416, "steps": [0, 0, 61, 166, 243, 294, 336]}, {"scene": "review", "from": 10930, "dur": 571, "steps": [0, 80, 150, 254, 303, 351, 392, 513]}, {"scene": "blind", "from": 11501, "dur": 583, "steps": [0, 70, 136, 203, 239, 310, 355, 408, 475]}, {"scene": "boundary", "from": 12084, "dur": 540, "steps": [0, 49, 125, 174, 234, 327, 363, 393, 423, 496]}, {"scene": "mine", "from": 12624, "dur": 586, "steps": [0, 52, 116, 173, 217, 308, 378, 445, 499]}, {"scene": "todo", "from": 13210, "dur": 339, "steps": [0, 33, 95, 140, 196, 243]}, {"scene": "close", "from": 13549, "dur": 903, "steps": [0, 17, 63, 136, 172, 276, 353, 391, 474, 580, 626, 675, 738, 801]}], "subs": [{"from": 7, "dur": 15, "text": "Hello 大家好"}, {"from": 30, "dur": 92, "text": "前两天群里有个人丢了问题："}, {"from": 133, "dur": 45, "text": "AI 都能做题了"}, {"from": 187, "dur": 53, "text": "那么还要数学系干什么呢"}, {"from": 263, "dur": 29, "text": "这件事的起因是"}, {"from": 292, "dur": 46, "text": "OpenAI 一次放出了"}, {"from": 338, "dur": 45, "text": "近 400 项数学成果"}, {"from": 383, "dur": 62, "text": "有的数学家看完之后觉得"}, {"from": 452, "dur": 82, "text": "这些东西已经够他消化好多年了"}, {"from": 535, "dur": 66, "text": "群里的反应其实很分裂"}, {"from": 601, "dur": 43, "text": "有一半人欢呼："}, {"from": 648, "dur": 69, "text": "哇，又能少写一些代码了"}, {"from": 733, "dur": 42, "text": "另一半人会担心："}, {"from": 778, "dur": 52, "text": "轮到我被迭代了"}, {"from": 831, "dur": 61, "text": "我听着那句话看了很久"}, {"from": 892, "dur": 64, "text": "觉得他问的不是数学"}, {"from": 957, "dur": 28, "text": "他问的是："}, {"from": 985, "dur": 68, "text": "如果有一样东西变强了"}, {"from": 1054, "dur": 88, "text": "那么原来靠这件东西吃饭的人"}, {"from": 1142, "dur": 27, "text": "会去哪呢"}, {"from": 1195, "dur": 31, "text": "按照这个问法"}, {"from": 1226, "dur": 59, "text": "答案好像只剩无处可去"}, {"from": 1293, "dur": 48, "text": "但我翻了一晚上资料"}, {"from": 1341, "dur": 77, "text": "发现发生的这件事和这个问法"}, {"from": 1419, "dur": 31, "text": "其实离得很远"}, {"from": 1462, "dur": 46, "text": "这里是像素呼吸"}, {"from": 1511, "dur": 46, "text": "今天我们一起聊一聊"}, {"from": 1562, "dur": 42, "text": "当 AI 越来越强"}, {"from": 1608, "dur": 52, "text": "什么东西会变得值钱呢"}, {"from": 1665, "dur": 43, "text": "首先我想跟大家承认的是"}, {"from": 1714, "dur": 64, "text": "这个担心真的没什么问题"}, {"from": 1793, "dur": 51, "text": "它的背后有一个默认推理："}, {"from": 1851, "dur": 44, "text": "一个东西便宜了"}, {"from": 1897, "dur": 60, "text": "那么和它有关的一切东西"}, {"from": 1957, "dur": 32, "text": "都跟着不值钱"}, {"from": 2002, "dur": 48, "text": "这个推理通常是对的"}, {"from": 2054, "dur": 55, "text": "同样一个东西如果有好几家做"}, {"from": 2115, "dur": 51, "text": "那么一家降价"}, {"from": 2168, "dur": 34, "text": "别家就跟着降"}, {"from": 2206, "dur": 68, "text": "整条街都不赚钱"}, {"from": 2280, "dur": 27, "text": "这叫替代"}, {"from": 2307, "dur": 88, "text": "你和那件东西干的其实是一件事"}, {"from": 2405, "dur": 55, "text": "比如一条卖衣服的街"}, {"from": 2461, "dur": 77, "text": "你卖 30，那么我卖 50"}, {"from": 2551, "dur": 72, "text": "我一定在价格上其实是不占优势的"}, {"from": 2624, "dur": 46, "text": "那我也要降价"}, {"from": 2671, "dur": 37, "text": "那降着降着"}, {"from": 2708, "dur": 110, "text": "其实整条街都不太能有很好的收益"}, {"from": 2825, "dur": 69, "text": "如果是两件事只是搭在一起用"}, {"from": 2894, "dur": 49, "text": "那么结论会反过来："}, {"from": 2944, "dur": 55, "text": "一个便宜，那么另一个就贵"}, {"from": 3021, "dur": 52, "text": "老家的县城，高铁通了"}, {"from": 3073, "dur": 71, "text": "从省城回去需要 40 分钟"}, {"from": 3145, "dur": 61, "text": "按理路程更便宜了"}, {"from": 3208, "dur": 64, "text": "小城里的东西也应该更便宜"}, {"from": 3273, "dur": 76, "text": "可是县城的酒店会先涨价"}, {"from": 3353, "dur": 87, "text": "每个周末订房得提前两天去预订"}, {"from": 3445, "dur": 96, "text": "我还专门查了资料，看看是不是错觉"}, {"from": 3543, "dur": 35, "text": "有研究计算过"}, {"from": 3583, "dur": 70, "text": "如果沿线城市的旅游人数"}, {"from": 3653, "dur": 38, "text": "涨了 18.5%"}, {"from": 3691, "dur": 72, "text": "那么旅游收入会涨 25%"}, {"from": 3764, "dur": 78, "text": "另一个团队去算了 178 个城市"}, {"from": 3862, "dur": 61, "text": "平均收入涨了 12%"}, {"from": 3924, "dur": 78, "text": "高铁没有让县城变得更便宜"}, {"from": 4003, "dur": 76, "text": "反而它却把需求都挤进了县城"}, {"from": 4080, "dur": 61, "text": "当高铁能通往这个县城"}, {"from": 4142, "dur": 86, "text": "那么这里的人流量就会越变越大"}, {"from": 4228, "dur": 40, "text": "当人流量多了"}, {"from": 4269, "dur": 51, "text": "这些需求也被带了进来"}, {"from": 4329, "dur": 42, "text": "更狠的一个是光伏"}, {"from": 4371, "dur": 68, "text": "它的组件 2022 年底"}, {"from": 4439, "dur": 72, "text": "平均下来两块一毛钱一瓦"}, {"from": 4511, "dur": 55, "text": "2025 年 3 月份"}, {"from": 4567, "dur": 48, "text": "光伏越来越轻松"}, {"from": 4628, "dur": 70, "text": "可国际能源署的数据却不是这样的："}, {"from": 4699, "dur": 24, "text": "过去五年"}, {"from": 4723, "dur": 60, "text": "电网用的电缆和变压器"}, {"from": 4789, "dur": 35, "text": "价格几乎翻倍"}, {"from": 4825, "dur": 85, "text": "变压器的交期从几个月变成两三年"}, {"from": 4922, "dur": 64, "text": "光伏这里的板子变便宜了"}, {"from": 4986, "dur": 92, "text": "但是把电送出去这件事就变贵了"}, {"from": 5090, "dur": 39, "text": "翻译一下："}, {"from": 5129, "dur": 46, "text": "如果一个东西降价"}, {"from": 5176, "dur": 75, "text": "那么不会让全世界都变便宜"}, {"from": 5251, "dur": 57, "text": "它会把需求挤到一旁"}, {"from": 5323, "dur": 57, "text": "那么如果 AI 被降价之后"}, {"from": 5380, "dur": 60, "text": "被挤的是哪一样东西呢"}, {"from": 5447, "dur": 60, "text": "一百年前，电也这么“没用”过"}, {"from": 5517, "dur": 43, "text": "爱迪生点亮了电灯"}, {"from": 5576, "dur": 92, "text": "1882 年，纽约珍珠街的电厂才供电"}, {"from": 5674, "dur": 48, "text": "那会儿的工程师就明白"}, {"from": 5730, "dur": 45, "text": "电会改掉工厂"}, {"from": 5779, "dur": 50, "text": "可接下来的 30 年"}, {"from": 5834, "dur": 70, "text": "工厂的生产效率几乎没有怎么动"}, {"from": 5921, "dur": 72, "text": "电便宜了，机器也换了"}, {"from": 5999, "dur": 59, "text": "为什么活还没有变快呢"}, {"from": 6071, "dur": 80, "text": "为什么我们的效率依然没有增加呢"}, {"from": 6169, "dur": 37, "text": "十九世纪的工厂"}, {"from": 6206, "dur": 41, "text": "整体只依靠一根总轴"}, {"from": 6255, "dur": 95, "text": "水轮或蒸汽机都在工厂外面去转"}, {"from": 6360, "dur": 73, "text": "带动厂房顶上的那条长轴"}, {"from": 6447, "dur": 57, "text": "轴上挂了一圈皮带"}, {"from": 6512, "dur": 75, "text": "皮带垂下来连着一台又一台的机器"}, {"from": 6600, "dur": 54, "text": "这个是之前的死规矩："}, {"from": 6658, "dur": 81, "text": "所有机器都会围着这根总轴转"}, {"from": 6751, "dur": 62, "text": "车间只能按照动力去排"}, {"from": 6821, "dur": 50, "text": "不能按照工序去排"}, {"from": 6901, "dur": 46, "text": "当电走入人们的生活"}, {"from": 6953, "dur": 43, "text": "很多工厂干了什么"}, {"from": 7013, "dur": 49, "text": "首先，把外面的蒸汽机"}, {"from": 7062, "dur": 59, "text": "换成一个特别大的电动机"}, {"from": 7125, "dur": 76, "text": "总轴还在，皮带也没变"}, {"from": 7208, "dur": 77, "text": "机器还是要围着那根总轴去转"}, {"from": 7288, "dur": 45, "text": "这叫成组驱动"}, {"from": 7340, "dur": 92, "text": "而车间依然还是原来的那套运行规则"}, {"from": 7449, "dur": 56, "text": "总轴一开，全厂都转"}, {"from": 7519, "dur": 86, "text": "长轴上摩擦消耗的力比干活的还多"}, {"from": 7627, "dur": 32, "text": "哪怕只想开一台"}, {"from": 7659, "dur": 45, "text": "机器只能摆两排"}, {"from": 7712, "dur": 80, "text": "物料从这头搬过去再运回来"}, {"from": 7808, "dur": 34, "text": "吃到电的好处"}, {"from": 7847, "dur": 70, "text": "那么就需要把整个工厂拆掉重建"}, {"from": 7918, "dur": 75, "text": "每个机器配一个小电机"}, {"from": 8002, "dur": 42, "text": "想开哪台就开哪台"}, {"from": 8048, "dur": 93, "text": "并且车间也不用围着这一根总轴去转"}, {"from": 8157, "dur": 43, "text": "按照工序进行排布"}, {"from": 8201, "dur": 49, "text": "物料也从一头进"}, {"from": 8254, "dur": 29, "text": "从另一头出"}, {"from": 8301, "dur": 42, "text": "时间花了多久呢"}, {"from": 8357, "dur": 68, "text": "1882 年已经开始了供电"}, {"from": 8429, "dur": 41, "text": "直到 1920 年代"}, {"from": 8470, "dur": 70, "text": "才真正开始进行工厂的迭代"}, {"from": 8541, "dur": 42, "text": "将近 40 年"}, {"from": 8597, "dur": 38, "text": "那这 40 年不是没电"}, {"from": 8638, "dur": 44, "text": "而是大家都不敢拆"}, {"from": 8686, "dur": 75, "text": "厂房是钱，总轴也是钱"}, {"from": 8778, "dur": 91, "text": "停产重排更是一些资金的消耗"}, {"from": 8874, "dur": 35, "text": "一直到 1920 年代"}, {"from": 8909, "dur": 49, "text": "投资环境变好了"}, {"from": 8958, "dur": 88, "text": "才有人整片的重新盖起新的厂房"}, {"from": 9064, "dur": 50, "text": "电作为工厂动力的份额"}, {"from": 9114, "dur": 85, "text": "在 1919 年的时候只刚过一半"}, {"from": 9199, "dur": 63, "text": "在 1929 年接近八成"}, {"from": 9269, "dur": 49, "text": "制造业生产增速"}, {"from": 9318, "dur": 85, "text": "1920 年代远超之前 20 年"}, {"from": 9403, "dur": 82, "text": "研究这一段的经济学家估算"}, {"from": 9498, "dur": 34, "text": "其中至少一半"}, {"from": 9532, "dur": 81, "text": "能归结到拆总轴这件事情上"}, {"from": 9636, "dur": 26, "text": "翻译一下"}, {"from": 9662, "dur": 77, "text": "让工厂变快的是重构整个厂房"}, {"from": 9743, "dur": 72, "text": "电只是让重构变得更划算"}, {"from": 9823, "dur": 26, "text": "电变便宜之后"}, {"from": 9849, "dur": 41, "text": "跟着变贵的不是电"}, {"from": 9896, "dur": 65, "text": "而是怎么知道重构的那批人"}, {"from": 9967, "dur": 48, "text": "和愿意停产重构的时间"}, {"from": 10036, "dur": 45, "text": "那么难点在哪里呢"}, {"from": 10103, "dur": 45, "text": "技术很早就到位了"}, {"from": 10148, "dur": 78, "text": "重构却不在大家的采购清单上"}, {"from": 10242, "dur": 44, "text": "没有报价，没有供应商"}, {"from": 10287, "dur": 48, "text": "没有人能给你开一张"}, {"from": 10335, "dur": 43, "text": "“换一种排法”的发票"}, {"from": 10378, "dur": 67, "text": "这 40 年卡的就是这个"}, {"from": 10476, "dur": 25, "text": "我们回到 AI"}, {"from": 10506, "dur": 63, "text": "用同一套看法再去看一遍"}, {"from": 10575, "dur": 93, "text": "AI 变便宜，变的是“做”那件事："}, {"from": 10680, "dur": 71, "text": "写一段文字，画一张画"}, {"from": 10757, "dur": 49, "text": "当“做”变便宜了"}, {"from": 10808, "dur": 37, "text": "需求就被挤到一边"}, {"from": 10850, "dur": 65, "text": "我的判断是，挤到“看”上"}, {"from": 10930, "dur": 76, "text": "AI 一天可以写出你之前一周写的量"}, {"from": 11010, "dur": 65, "text": "但你要看的量也跟着上涨"}, {"from": 11080, "dur": 96, "text": "它写的越多，你越得需要逐条去检验"}, {"from": 11184, "dur": 43, "text": "那么去检验什么呢"}, {"from": 11233, "dur": 46, "text": "检验它有没有编数据"}, {"from": 11281, "dur": 37, "text": "有没有产生幻觉"}, {"from": 11322, "dur": 106, "text": "有没有出现一些违反现实的一些反例"}, {"from": 11443, "dur": 58, "text": "这句结论能不能落到账上呢"}, {"from": 11501, "dur": 66, "text": "以前会不那么较真"}, {"from": 11571, "dur": 66, "text": "因为自己写的，大概都知道"}, {"from": 11637, "dur": 67, "text": "哪个地方我没有去查数据"}, {"from": 11704, "dur": 36, "text": "或者哪个地方"}, {"from": 11740, "dur": 71, "text": "我去进行了一些数据的构造"}, {"from": 11811, "dur": 45, "text": "但现在虚的地方"}, {"from": 11856, "dur": 45, "text": "是 AI 替我留的"}, {"from": 11909, "dur": 64, "text": "会写现在已经不是很稀缺"}, {"from": 11976, "dur": 87, "text": "稀缺的是如何能看出哪个部分不对"}, {"from": 12084, "dur": 44, "text": "一件东西变便宜"}, {"from": 12133, "dur": 72, "text": "那么旁边没有配套的稀缺环节"}, {"from": 12209, "dur": 49, "text": "那就只是单纯变便宜"}, {"from": 12258, "dur": 58, "text": "比如当盐降价了"}, {"from": 12318, "dur": 93, "text": "没有人会因为想去多吃一点盐"}, {"from": 12411, "dur": 36, "text": "而去学做饭"}, {"from": 12447, "dur": 30, "text": "AI 也一样"}, {"from": 12477, "dur": 30, "text": "用它的时候"}, {"from": 12507, "dur": 73, "text": "身边没有别的东西变得紧张"}, {"from": 12580, "dur": 44, "text": "那你就是纯省钱"}, {"from": 12624, "dur": 48, "text": "我自己的感受是"}, {"from": 12676, "dur": 64, "text": "现在的紧张是“相信”这件事"}, {"from": 12740, "dur": 55, "text": "以前当我写完文章"}, {"from": 12797, "dur": 34, "text": "可以直接发出去"}, {"from": 12841, "dur": 91, "text": "因为文章是我一个字一个字敲出来的"}, {"from": 12932, "dur": 67, "text": "但现在，AI 写完之后"}, {"from": 13002, "dur": 56, "text": "我需要这儿看一下、那儿看一下"}, {"from": 13069, "dur": 53, "text": "并且去验证其中的例子"}, {"from": 13123, "dur": 70, "text": "这些就是眼下最贵的地方"}, {"from": 13210, "dur": 33, "text": "这周我需要找一个时间"}, {"from": 13243, "dur": 61, "text": "去把 AI 帮我写过的文章"}, {"from": 13305, "dur": 31, "text": "以及干过的事"}, {"from": 13350, "dur": 56, "text": "仔仔细细地剖析一遍："}, {"from": 13406, "dur": 47, "text": "它到底哪里不行"}, {"from": 13453, "dur": 78, "text": "到底哪里是真正可以替代我的地方"}, {"from": 13549, "dur": 16, "text": "回到开头"}, {"from": 13566, "dur": 46, "text": "那现在还需要数学系"}, {"from": 13612, "dur": 51, "text": "和这些数学专家干什么"}, {"from": 13685, "dur": 36, "text": "我的答案变了一点"}, {"from": 13721, "dur": 104, "text": "如果 AI 一次真的能产出几百项成果"}, {"from": 13825, "dur": 76, "text": "那么最先不够用的是这些"}, {"from": 13902, "dur": 38, "text": "能判断这些成果"}, {"from": 13940, "dur": 64, "text": "是否用到我们生活中的专家"}, {"from": 14023, "dur": 88, "text": "上期我们说了，AI 越便宜你用的越多"}, {"from": 14129, "dur": 45, "text": "现在我要补后半句："}, {"from": 14175, "dur": 39, "text": "当你用的越多"}, {"from": 14224, "dur": 63, "text": "越需要一个能说“这条不对”的人"}, {"from": 14287, "dur": 63, "text": "那个人现在还挺贵的"}, {"from": 14350, "dur": 42, "text": "我们下期聊"}], "source": "srt"}