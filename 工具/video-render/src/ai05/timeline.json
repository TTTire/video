{"fps": 30, "total": 10879, "scenes": [{"scene": "renew", "from": 0, "dur": 190, "steps": [6]}, {"scene": "drain", "from": 190, "dur": 487, "steps": [0, 272]}, {"scene": "leek", "from": 677, "dur": 469, "steps": [0, 199]}, {"scene": "hook", "from": 1146, "dur": 205, "steps": [0]}, {"scene": "title", "from": 1351, "dur": 144, "steps": [0]}, {"scene": "chapter", "from": 1495, "dur": 66, "steps": [0], "chapter": 1, "title": "软件不花钱，AI 花钱"}, {"scene": "cd", "from": 1561, "dur": 789, "steps": [0, 511]}, {"scene": "price", "from": 2350, "dur": 496, "steps": [0]}, {"scene": "marginal", "from": 2846, "dur": 469, "steps": [0]}, {"scene": "buffet", "from": 3315, "dur": 306, "steps": [0]}, {"scene": "overseas", "from": 3621, "dur": 438, "steps": [0]}, {"scene": "mismatch", "from": 4059, "dur": 291, "steps": [0]}, {"scene": "chapter", "from": 4350, "dur": 66, "steps": [0], "chapter": 2, "title": "价格不管事，就只能排队"}, {"scene": "queue", "from": 4416, "dur": 338, "steps": [0]}, {"scene": "ration", "from": 4754, "dur": 424, "steps": [0]}, {"scene": "heavy", "from": 5178, "dur": 407, "steps": [0]}, {"scene": "kimi", "from": 5585, "dur": 576, "steps": [0, 265]}, {"scene": "kimioct", "from": 6161, "dur": 594, "steps": [0]}, {"scene": "quality", "from": 6755, "dur": 307, "steps": [0]}, {"scene": "newmodel", "from": 7062, "dur": 425, "steps": [0]}, {"scene": "aol", "from": 7487, "dur": 640, "steps": [0]}, {"scene": "youqueue", "from": 8127, "dur": 165, "steps": [0]}, {"scene": "chapter", "from": 8292, "dur": 66, "steps": [0], "chapter": 3, "title": "看到\"不限量\"，先问一句"}, {"scene": "boundary", "from": 8358, "dur": 472, "steps": [0]}, {"scene": "offpeak", "from": 8830, "dur": 447, "steps": [0]}, {"scene": "telecom", "from": 9277, "dur": 545, "steps": [0]}, {"scene": "ask", "from": 9822, "dur": 477, "steps": [0]}, {"scene": "close", "from": 10299, "dur": 580, "steps": [0, 330]}], "points": {"0.1": 6, "0.2": 190, "0.3": 462, "0.4": 677, "0.5": 876, "0.6": 1146, "0.7": 1351, "1.0": 1495, "1.1": 1561, "1.2": 2072, "1.3": 2350, "1.4": 2846, "1.5": 3315, "1.6": 3621, "1.7": 4059, "2.0": 4350, "2.1": 4416, "2.2": 4754, "2.3": 5178, "2.4": 5585, "2.5": 5850, "2.6": 6161, "2.7": 6755, "2.8": 7062, "2.9": 7487, "2.10": 8127, "3.0": 8292, "3.1": 8358, "3.2": 8830, "3.3": 9277, "3.4": 9822, "3.5": 10299, "3.6": 10299, "3.7": 10629}, "subs": [{"from": 6, "dur": 121, "text": "10月中旬 一位研发总监花了1908块"}, {"from": 128, "dur": 58, "text": "把Kimi会员续了整整一年"}, {"from": 191, "dur": 105, "text": "第二天 他让Kimi去帮他做一个5分钟的视频"}, {"from": 298, "dur": 109, "text": "任务跑了20多分钟 额度从100%掉到了0"}, {"from": 409, "dur": 47, "text": "视频也没有做出来"}, {"from": 462, "dur": 59, "text": "他去找客服 客服跟他说"}, {"from": 523, "dur": 82, "text": "过程里生成了20多个中间视频"}, {"from": 607, "dur": 63, "text": "额度确实用掉了 恢复不了"}, {"from": 677, "dur": 94, "text": "换谁第一反应都是 这不就是割韭菜吗"}, {"from": 772, "dur": 103, "text": "一年的钱已经收了 但20分钟就不给用了"}, {"from": 876, "dur": 92, "text": "可同一个月 这家公司又发了一封道歉信"}, {"from": 970, "dur": 59, "text": "给所有会员补充额度"}, {"from": 1031, "dur": 111, "text": "要只是抠门 真的犯不着一边收钱一边道歉"}, {"from": 1146, "dur": 63, "text": "问题出在多用一次上"}, {"from": 1212, "dur": 52, "text": "对你它不要钱"}, {"from": 1266, "dur": 79, "text": "可对它 每次计算都在花钱"}, {"from": 1351, "dur": 39, "text": "这里是像素呼吸"}, {"from": 1392, "dur": 112, "text": "今天我们一起聊一聊AI会员为什么总不够用"}, {"from": 1531, "dur": 90, "text": "先说抠门的这个判断到底从哪里来的呢"}, {"from": 1632, "dur": 59, "text": "我们用了几十年的互联网"}, {"from": 1693, "dur": 81, "text": "每多一个人用 几乎不会多花什么钱"}, {"from": 1775, "dur": 102, "text": "经济学教材里的例子 当一张唱片录好以后"}, {"from": 1879, "dur": 86, "text": "多印一张CD 成本价不到1美元"}, {"from": 1968, "dur": 94, "text": "可在网上多下载一份 成本几乎为零"}, {"from": 2072, "dur": 93, "text": "所以 APP敢免费 敢说不限量"}, {"from": 2166, "dur": 78, "text": "是多给你一份 它几乎不花什么钱"}, {"from": 2246, "dur": 96, "text": "这种东西还说不够用 那才是真的抠门"}, {"from": 2350, "dur": 45, "text": "可AI不一样"}, {"from": 2396, "dur": 77, "text": "它每回答一次都要真的跑一遍显卡"}, {"from": 2474, "dur": 38, "text": "去做一次计算"}, {"from": 2517, "dur": 38, "text": "真烧一份电"}, {"from": 2556, "dur": 97, "text": "Kimi自己的加油包里写着 让它推荐一首歌"}, {"from": 2654, "dur": 48, "text": "大概要花3分钱"}, {"from": 2703, "dur": 95, "text": "让它规划一周成都到川西的自驾游路线"}, {"from": 2800, "dur": 44, "text": "差不多要花1块6"}, {"from": 2846, "dur": 49, "text": "翻译一下我们上面讲的"}, {"from": 2897, "dur": 70, "text": "每多答一次是有价钱的"}, {"from": 2969, "dur": 68, "text": "在经济学里 这叫做边际成本"}, {"from": 3038, "dur": 84, "text": "也就是 每多做一份要多花的钱"}, {"from": 3124, "dur": 111, "text": "100个经济学原理的第3期讲过 边际分析"}, {"from": 3243, "dur": 71, "text": "这回边际落在了卖家那边"}, {"from": 3315, "dur": 107, "text": "可包月把你这边的价钱拿掉了 像自助餐"}, {"from": 3427, "dur": 97, "text": "交了钱之后 多拿一盘不会多花一分钱"}, {"from": 3532, "dur": 88, "text": "你就会一直拿 只要拿到你满意为止"}, {"from": 3621, "dur": 89, "text": "不止是国内这样 11月初OpenAI说"}, {"from": 3712, "dur": 110, "text": "12月起ChatGPT和Codex共用一份额度"}, {"from": 3824, "dur": 41, "text": "按一份token算"}, {"from": 3866, "dur": 63, "text": "马斯克回复用户时也说"}, {"from": 3932, "dur": 80, "text": "Grok Bot的服务成本相对于收入"}, {"from": 4017, "dur": 40, "text": "高得难以为继"}, {"from": 4059, "dur": 109, "text": "而我的理解是 卖家那边每一句都有价"}, {"from": 4172, "dur": 74, "text": "而你这边每一句的成本都是零"}, {"from": 4248, "dur": 111, "text": "账的两头对不上 那么我们拿什么去管住你呢"}, {"from": 4387, "dur": 38, "text": "平常售卖的东西"}, {"from": 4426, "dur": 72, "text": "想要的人一多 它的需求就大"}, {"from": 4503, "dur": 71, "text": "当需求大了之后 价格就会上涨"}, {"from": 4578, "dur": 59, "text": "当涨到所有人都已经买不起了的时候"}, {"from": 4639, "dur": 51, "text": "那么也就不涨了"}, {"from": 4692, "dur": 61, "text": "价格在替大家进行排队"}, {"from": 4754, "dur": 61, "text": "当包月把价格定死了"}, {"from": 4816, "dur": 53, "text": "那么它就只剩别的办法"}, {"from": 4872, "dur": 82, "text": "比如去限额 排队 停卖"}, {"from": 4955, "dur": 40, "text": "或者去少给一点"}, {"from": 4998, "dur": 55, "text": "在经济学上叫配给"}, {"from": 5054, "dur": 122, "text": "不单纯去靠价格 而是靠规矩给大家分量"}, {"from": 5178, "dur": 97, "text": "在包月的限定额度里 总有人用得特别狠"}, {"from": 5276, "dur": 90, "text": "像Anthropic去年给会员加限制的时候说"}, {"from": 5371, "dur": 90, "text": "会碰到限额的其实不到5%的用户"}, {"from": 5469, "dur": 55, "text": "但少数人会吃掉大头"}, {"from": 5526, "dur": 58, "text": "大多数人会陪着一起排队"}, {"from": 5585, "dur": 88, "text": "Kimi这半年把几种方法都用了一遍"}, {"from": 5674, "dur": 58, "text": "每次都在模型上线之后"}, {"from": 5734, "dur": 109, "text": "4月 新模型一上线 会员就开始排队"}, {"from": 5850, "dur": 81, "text": "当7月份新模型上线刚两天"}, {"from": 5932, "dur": 109, "text": "请求量大大超过预估 干脆直接停卖了会员"}, {"from": 6043, "dur": 113, "text": "原话是 把目前的算力分配到已有的会员中"}, {"from": 6161, "dur": 91, "text": "10月底 又一个新的模型上线了两天"}, {"from": 6253, "dur": 59, "text": "Kimi直接向大家公开道歉"}, {"from": 6313, "dur": 87, "text": "给所有会员补回四分之一个月的额度"}, {"from": 6402, "dur": 73, "text": "在同一封信里 Kimi也说道"}, {"from": 6477, "dur": 113, "text": "我们正在减少不必要的Agent调用和输出长度"}, {"from": 6594, "dur": 106, "text": "翻译一下就是 同样的额度让AI少干一点"}, {"from": 6702, "dur": 51, "text": "少费一些不需要的token"}, {"from": 6755, "dur": 34, "text": "我的理解是"}, {"from": 6791, "dur": 91, "text": "少输出的这几句其实也是一种配给"}, {"from": 6884, "dur": 63, "text": "教材里讲限价的时候也说"}, {"from": 6948, "dur": 103, "text": "当价格被限制之后 质量也有可能随之下降"}, {"from": 7062, "dur": 75, "text": "为什么偏偏是新模型上线的时候"}, {"from": 7138, "dur": 66, "text": "新模型更能干 也更能花"}, {"from": 7206, "dur": 58, "text": "开头那位总监让它做视频"}, {"from": 7265, "dur": 80, "text": "后台一口气生成了20个中间视频"}, {"from": 7346, "dur": 70, "text": "10月那次 Kimi自己也认了"}, {"from": 7418, "dur": 67, "text": "有一部分是不必要的额度消耗"}, {"from": 7487, "dur": 52, "text": "这也不是AI才有的事"}, {"from": 7541, "dur": 98, "text": "1996年底 美国的AOL把拨号上网"}, {"from": 7640, "dur": 87, "text": "改成19.95美元 一个月随便上"}, {"from": 7730, "dur": 75, "text": "会员每天在线从9月的14分钟"}, {"from": 7806, "dur": 75, "text": "涨到第二年1月份的32分钟"}, {"from": 7893, "dur": 43, "text": "拨号全是忙音"}, {"from": 7943, "dur": 68, "text": "老板公开请大家少上一会儿"}, {"from": 8013, "dur": 112, "text": "后来30多个州逼它按在线时长进行退钱"}, {"from": 8127, "dur": 86, "text": "价格不在场 那么就有人要去排队"}, {"from": 8222, "dur": 40, "text": "排队的人是谁呢"}, {"from": 8263, "dur": 37, "text": "就是交了会员的你"}, {"from": 8322, "dur": 92, "text": "不是每一次不够用都是算力真的不够"}, {"from": 8420, "dur": 35, "text": "像10月那一次"}, {"from": 8457, "dur": 98, "text": "Kimi自己也说自己有一部分是AI多花了"}, {"from": 8561, "dur": 71, "text": "而4月那次还把额度扣错了"}, {"from": 8638, "dur": 65, "text": "当晚给所有人都恢复到100%"}, {"from": 8712, "dur": 50, "text": "账算错 规则写不清"}, {"from": 8763, "dur": 59, "text": "一样会让你觉得自己被割了"}, {"from": 8830, "dur": 89, "text": "而另一条路 是让价格回来管事"}, {"from": 8921, "dur": 52, "text": "用得多 挤高峰的人"}, {"from": 8975, "dur": 62, "text": "那么也需要相应的多付一点"}, {"from": 9044, "dur": 102, "text": "DeepSeek去年就试过 当大家错峰使用"}, {"from": 9148, "dur": 51, "text": "最低会打到2.5折"}, {"from": 9205, "dur": 62, "text": "这条路怎么走还要另说"}, {"from": 9277, "dur": 59, "text": "你其实早就买过不限量"}, {"from": 9337, "dur": 48, "text": "在2019年的9月份"}, {"from": 9386, "dur": 97, "text": "中国电信停售达量限速的不限量套餐"}, {"from": 9485, "dur": 79, "text": "用到一定量 就限速降速的那种"}, {"from": 9566, "dur": 41, "text": "这个套餐被改成"}, {"from": 9608, "dur": 97, "text": "超出的部分会按照相应的流量进行收钱"}, {"from": 9706, "dur": 40, "text": "宣传里不许再写"}, {"from": 9747, "dur": 74, "text": "到达一定流量就限制大家的网速"}, {"from": 9822, "dur": 68, "text": "所以下次再看到不限量的时候"}, {"from": 9891, "dur": 46, "text": "我希望你多问一句"}, {"from": 9942, "dur": 83, "text": "它多给我一次 到底要不要多花钱"}, {"from": 10027, "dur": 102, "text": "几乎不花钱的内容 不限量才有可能是真的"}, {"from": 10135, "dur": 57, "text": "而每一次都要多花钱的部分"}, {"from": 10193, "dur": 104, "text": "不限量迟早会变成限额排队或者涨价"}, {"from": 10299, "dur": 107, "text": "回到开头 那位总监的额度不是谁偷走的"}, {"from": 10407, "dur": 82, "text": "而是多做一次不花钱花掉的"}, {"from": 10491, "dur": 79, "text": "会员卖的一直是一份有数的额度"}, {"from": 10571, "dur": 52, "text": "只是没有写在明处"}, {"from": 10629, "dur": 47, "text": "我还没有想明白的是"}, {"from": 10677, "dur": 56, "text": "如果有一天AI多回答一次"}, {"from": 10733, "dur": 58, "text": "真的便宜到几乎不花钱"}, {"from": 10793, "dur": 72, "text": "那么不限量的套餐会不会回来呢"}], "source": "starts"}