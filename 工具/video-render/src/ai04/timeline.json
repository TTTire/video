{"fps": 30, "total": 11821, "scenes": [{"scene": "app", "from": 0, "dur": 318, "steps": [9, 83, 144, 244]}, {"scene": "back", "from": 318, "dur": 263, "steps": [0, 74, 128, 195]}, {"scene": "post", "from": 581, "dur": 381, "steps": [0, 87, 134, 215, 260, 327]}, {"scene": "panic", "from": 962, "dur": 441, "steps": [0, 68, 155, 229, 274, 361]}, {"scene": "title", "from": 1403, "dur": 189, "steps": [0, 61, 106]}, {"scene": "chapter", "from": 1592, "dur": 66, "steps": [0], "chapter": 1, "title": "题在考什么"}, {"scene": "interview", "from": 1658, "dur": 538, "steps": [0, 0, 47, 114, 194, 249, 336, 416, 464]}, {"scene": "spence", "from": 2196, "dur": 478, "steps": [0, 80, 134, 202, 269, 314, 388, 433]}, {"scene": "costly", "from": 2674, "dur": 549, "steps": [0, 94, 174, 222, 267, 360, 415, 462]}, {"scene": "sixhundred", "from": 3223, "dur": 706, "steps": [0, 68, 148, 196, 270, 318, 378, 452, 520, 565, 632]}, {"scene": "ask", "from": 3929, "dur": 231, "steps": [0, 87, 148]}, {"scene": "chapter", "from": 4160, "dur": 66, "steps": [0], "chapter": 2, "title": "假的变便宜之后"}, {"scene": "coder", "from": 4226, "dur": 457, "steps": [0, 0, 79, 133, 181, 255, 316, 377]}, {"scene": "rescind", "from": 4683, "dur": 440, "steps": [0, 87, 174, 241, 289, 334, 395]}, {"scene": "townhall", "from": 5123, "dur": 389, "steps": [0, 93, 138, 225, 270, 315]}, {"scene": "bank", "from": 5512, "dur": 632, "steps": [0, 45, 113, 206, 254, 328, 395, 463, 523, 578]}, {"scene": "pooling", "from": 6144, "dur": 601, "steps": [0, 45, 112, 167, 254, 334, 379, 446, 527]}, {"scene": "blind", "from": 6745, "dur": 372, "steps": [0, 48, 93, 138, 225, 279]}, {"scene": "newsignal", "from": 7117, "dur": 565, "steps": [0, 55, 115, 183, 250, 295, 363, 450, 497]}, {"scene": "amazon", "from": 7682, "dur": 738, "steps": [0, 54, 154, 208, 263, 336, 397, 478, 565, 626, 693]}, {"scene": "twosignals", "from": 8420, "dur": 420, "steps": [0, 48, 108, 182, 256, 343]}, {"scene": "chapter", "from": 8840, "dur": 66, "steps": [0], "chapter": 3, "title": "现在该攒什么"}, {"scene": "stillworks", "from": 8906, "dur": 516, "steps": [0, 0, 46, 101, 174, 275, 362, 429]}, {"scene": "question", "from": 9422, "dur": 411, "steps": [0, 87, 161, 228, 282, 350]}, {"scene": "pku", "from": 9833, "dur": 731, "steps": [0, 67, 141, 221, 276, 350, 423, 504, 549, 610, 684]}, {"scene": "selfconsistent", "from": 10564, "dur": 452, "steps": [0, 68, 148, 196, 244, 337, 398]}, {"scene": "close", "from": 11016, "dur": 805, "steps": [0, 68, 113, 206, 254, 334, 389, 469, 563, 643, 691]}], "subs": [{"from": 9, "dur": 69, "text": "今年春天，电商平台上"}, {"from": 83, "dur": 56, "text": "一款 AI 面试助手"}, {"from": 144, "dur": 96, "text": "页面写着：全网热销超 60 万份"}, {"from": 244, "dur": 69, "text": "实时听题，照着念就行"}, {"from": 318, "dur": 69, "text": "可公司那边，在往回走"}, {"from": 392, "dur": 50, "text": "谷歌和麦肯锡"}, {"from": 446, "dur": 63, "text": "把面试搬回了线下"}, {"from": 513, "dur": 63, "text": "发 offer 前，至少见一面"}, {"from": 581, "dur": 82, "text": "10 月底，Anthropic 一位招聘经理"}, {"from": 668, "dur": 43, "text": "发了个帖子："}, {"from": 715, "dur": 76, "text": "他的团队，不考编程题了"}, {"from": 796, "dur": 41, "text": "题没变难"}, {"from": 841, "dur": 63, "text": "变的是，Claude 做这些题"}, {"from": 908, "dur": 50, "text": "已经比人强了"}, {"from": 962, "dur": 63, "text": "刷了几百道题的人"}, {"from": 1030, "dur": 82, "text": "看到这条，第一反应多半是："}, {"from": 1117, "dur": 69, "text": "那我这几个月白刷了"}, {"from": 1191, "dur": 41, "text": "先别急"}, {"from": 1236, "dur": 82, "text": "题考的，一直是另一样东西"}, {"from": 1323, "dur": 76, "text": "那样东西，刚刚变便宜了"}, {"from": 1403, "dur": 56, "text": "这里是像素呼吸"}, {"from": 1464, "dur": 41, "text": "今天聊聊"}, {"from": 1509, "dur": 76, "text": "刷题为什么突然没用了"}, {"from": 1589, "dur": 56, "text": "面试官出一道题"}, {"from": 1650, "dur": 50, "text": "你当场做出来"}, {"from": 1705, "dur": 63, "text": "他点点头，觉得你行"}, {"from": 1772, "dur": 76, "text": "看起来，题就是在考能力"}, {"from": 1852, "dur": 50, "text": "可公司想买的"}, {"from": 1907, "dur": 82, "text": "是你进来以后干活的样子"}, {"from": 1994, "dur": 76, "text": "这件事，面试那一个小时"}, {"from": 2074, "dur": 43, "text": "谁都看不见"}, {"from": 2122, "dur": 69, "text": "看不见，就只能看替身"}, {"from": 2196, "dur": 76, "text": "1973 年，经济学家斯宾塞"}, {"from": 2276, "dur": 50, "text": "写了一篇论文"}, {"from": 2330, "dur": 63, "text": "讲的就是这个替身"}, {"from": 2398, "dur": 63, "text": "他举的例子是文凭"}, {"from": 2465, "dur": 40, "text": "一张文凭"}, {"from": 2510, "dur": 69, "text": "不一定让你更会干活"}, {"from": 2584, "dur": 40, "text": "但它管用"}, {"from": 2629, "dur": 40, "text": "为什么"}, {"from": 2674, "dur": 89, "text": "能力强的人，拿到它比较便宜；"}, {"from": 2768, "dur": 76, "text": "能力弱的人，拿到它很贵"}, {"from": 2848, "dur": 43, "text": "甚至拿不到"}, {"from": 2896, "dur": 40, "text": "翻译一下："}, {"from": 2941, "dur": 89, "text": "信号管用，不是因为它像能力"}, {"from": 3034, "dur": 50, "text": "是因为假的贵"}, {"from": 3089, "dur": 43, "text": "公司看文凭"}, {"from": 3136, "dur": 82, "text": "其实在看你为它付了多少"}, {"from": 3223, "dur": 63, "text": "刷题，是同一个道理"}, {"from": 3291, "dur": 76, "text": "哥伦比亚大学有个学生"}, {"from": 3371, "dur": 43, "text": "为了进大厂"}, {"from": 3419, "dur": 69, "text": "刷了 600 个小时的题"}, {"from": 3493, "dur": 43, "text": "600 个小时"}, {"from": 3541, "dur": 56, "text": "差不多是一个人"}, {"from": 3601, "dur": 69, "text": "三个多月的上班时间"}, {"from": 3675, "dur": 63, "text": "面试官那一小时里"}, {"from": 3743, "dur": 40, "text": "看到的"}, {"from": 3788, "dur": 63, "text": "是你肯不肯、能不能"}, {"from": 3855, "dur": 69, "text": "为它花这 600 个小时"}, {"from": 3929, "dur": 82, "text": "所以题考的，一直是这件事："}, {"from": 4016, "dur": 56, "text": "假的，到底有多贵"}, {"from": 4077, "dur": 76, "text": "那假的要是变便宜了呢"}, {"from": 4157, "dur": 63, "text": "就是刚才那个学生"}, {"from": 4225, "dur": 76, "text": "2025 年 3 月，他 21 岁"}, {"from": 4305, "dur": 50, "text": "用 AI 不到一周"}, {"from": 4359, "dur": 43, "text": "做了个软件"}, {"from": 4407, "dur": 69, "text": "面试的时候挂在后台"}, {"from": 4481, "dur": 56, "text": "他说，录屏看不见"}, {"from": 4542, "dur": 56, "text": "摄像头也看不见"}, {"from": 4603, "dur": 76, "text": "题目一出，答案就在旁边"}, {"from": 4683, "dur": 82, "text": "他拿它过了亚马逊的面试"}, {"from": 4770, "dur": 82, "text": "还把过程录下来，发到网上"}, {"from": 4857, "dur": 63, "text": "亚马逊和另外几家"}, {"from": 4924, "dur": 43, "text": "把 offer 都撤了"}, {"from": 4972, "dur": 40, "text": "软件没停"}, {"from": 5017, "dur": 56, "text": "一个月 60 美元"}, {"from": 5078, "dur": 40, "text": "照卖"}, {"from": 5123, "dur": 89, "text": "也是那段时间，谷歌内部开会"}, {"from": 5216, "dur": 40, "text": "有员工问："}, {"from": 5261, "dur": 82, "text": "能不能把线下面试要回来"}, {"from": 5348, "dur": 40, "text": "Pichai 当场说："}, {"from": 5393, "dur": 40, "text": "值得想想"}, {"from": 5438, "dur": 69, "text": "一部分面试放回线下"}, {"from": 5512, "dur": 40, "text": "国内一样"}, {"from": 5557, "dur": 63, "text": "今年银行招应届生"}, {"from": 5625, "dur": 89, "text": "好几家把 AI 面试加进了流程"}, {"from": 5718, "dur": 43, "text": "电商平台上"}, {"from": 5766, "dur": 69, "text": "AI 面试助手跟着卖爆："}, {"from": 5840, "dur": 63, "text": "138 块钱，两个小时"}, {"from": 5907, "dur": 63, "text": "398 块以上的套餐"}, {"from": 5975, "dur": 56, "text": "还帮你矫正眼神"}, {"from": 6035, "dur": 50, "text": "看答案的时候"}, {"from": 6090, "dur": 50, "text": "别像在看答案"}, {"from": 6144, "dur": 40, "text": "到这一步"}, {"from": 6189, "dur": 63, "text": "信号的逻辑就变了"}, {"from": 6256, "dur": 50, "text": "原来那个信号"}, {"from": 6311, "dur": 82, "text": "要 600 个小时才发得出来"}, {"from": 6398, "dur": 76, "text": "现在，138 块钱，两个小时"}, {"from": 6478, "dur": 40, "text": "谁都能发"}, {"from": 6523, "dur": 63, "text": "经济学管这叫混同："}, {"from": 6590, "dur": 76, "text": "所有人发的信号都一样"}, {"from": 6671, "dur": 69, "text": "信号就分不出谁是谁"}, {"from": 6745, "dur": 43, "text": "我的理解是："}, {"from": 6793, "dur": 40, "text": "题目还在"}, {"from": 6838, "dur": 40, "text": "答案还对"}, {"from": 6883, "dur": 82, "text": "但它不再告诉公司任何事"}, {"from": 6970, "dur": 50, "text": "公司没有不看"}, {"from": 7024, "dur": 89, "text": "它换了一个假的还贵的信号"}, {"from": 7117, "dur": 50, "text": "麦肯锡：发 offer 前"}, {"from": 7172, "dur": 56, "text": "至少线下见一面"}, {"from": 7232, "dur": 63, "text": "谷歌：至少一轮线下"}, {"from": 7300, "dur": 63, "text": "Anthropic 那位经理更直接："}, {"from": 7367, "dur": 40, "text": "不考题了"}, {"from": 7412, "dur": 63, "text": "看简历和作品集里"}, {"from": 7480, "dur": 82, "text": "那些周末做出来的小原型"}, {"from": 7567, "dur": 43, "text": "有没有品味"}, {"from": 7614, "dur": 63, "text": "有没有替用户想过"}, {"from": 7682, "dur": 50, "text": "同一天，亚马逊"}, {"from": 7736, "dur": 96, "text": "把一份工程师准则挂到了官网"}, {"from": 7836, "dur": 50, "text": "说 token 用了多少、"}, {"from": 7890, "dur": 50, "text": "AI 用得多不多"}, {"from": 7945, "dur": 69, "text": "这些数字，原话是 deeply flawed"}, {"from": 8018, "dur": 56, "text": "翻译过来：靠不住"}, {"from": 8079, "dur": 76, "text": "以后看长期的业务结果"}, {"from": 8160, "dur": 82, "text": "今年 5 月，他们还关掉了"}, {"from": 8247, "dur": 56, "text": "一个内部排行榜"}, {"from": 8308, "dur": 63, "text": "因为有人为了上榜"}, {"from": 8375, "dur": 41, "text": "在狂刷 token"}, {"from": 8420, "dur": 43, "text": "两边，同一天"}, {"from": 8468, "dur": 56, "text": "做的是同一件事"}, {"from": 8528, "dur": 69, "text": "旧信号：你会不会做题"}, {"from": 8602, "dur": 69, "text": "新信号：你做出过什么"}, {"from": 8676, "dur": 82, "text": "第一个，AI 一晚上能替你做"}, {"from": 8763, "dur": 69, "text": "第二个，到今天还不行"}, {"from": 8837, "dur": 63, "text": "线下笔试，现场白板"}, {"from": 8905, "dur": 43, "text": "这些没失效"}, {"from": 8952, "dur": 50, "text": "造假还是贵的"}, {"from": 9007, "dur": 69, "text": "银行也没取消 AI 面试"}, {"from": 9080, "dur": 96, "text": "它加了眼球追踪、加了人工复核"}, {"from": 9181, "dur": 82, "text": "把造假的成本重新抬回去"}, {"from": 9268, "dur": 63, "text": "失效的，是隔着屏幕、"}, {"from": 9335, "dur": 82, "text": "能查到标准答案的那一类"}, {"from": 9422, "dur": 82, "text": "所以现在可以问自己一句："}, {"from": 9509, "dur": 69, "text": "你手上攒的那个信号"}, {"from": 9583, "dur": 63, "text": "别人用 AI 一个晚上"}, {"from": 9650, "dur": 50, "text": "能不能做出来"}, {"from": 9704, "dur": 63, "text": "能，它已经不值钱了"}, {"from": 9772, "dur": 56, "text": "不能，它正在变贵"}, {"from": 9833, "dur": 63, "text": "上个月在北大蹭课"}, {"from": 9900, "dur": 69, "text": "有同学问杨锦方老师："}, {"from": 9974, "dur": 76, "text": "面试就半小时到一小时"}, {"from": 10054, "dur": 50, "text": "怎么看一个人"}, {"from": 10109, "dur": 69, "text": "老师给了三个筛选器"}, {"from": 10183, "dur": 69, "text": "头一个就是一个问题："}, {"from": 10256, "dur": 76, "text": "你有什么非共识的判断"}, {"from": 10337, "dur": 41, "text": "他也说"}, {"from": 10382, "dur": 56, "text": "答不上来，算正常"}, {"from": 10443, "dur": 69, "text": "我坐在下面想了一下"}, {"from": 10517, "dur": 43, "text": "也没答上来"}, {"from": 10564, "dur": 63, "text": "第二个问题挨着它："}, {"from": 10632, "dur": 76, "text": "这个判断是怎么形成的"}, {"from": 10712, "dur": 43, "text": "一步一步讲"}, {"from": 10760, "dur": 43, "text": "得逻辑自洽"}, {"from": 10808, "dur": 89, "text": "这个问题，AI 也能替你编一个"}, {"from": 10901, "dur": 56, "text": "可追两句，就散了"}, {"from": 10962, "dur": 50, "text": "它贵，就贵在这"}, {"from": 11016, "dur": 63, "text": "回到开头那条新闻"}, {"from": 11084, "dur": 41, "text": "题没白刷"}, {"from": 11129, "dur": 89, "text": "那 600 个小时练出来的东西"}, {"from": 11222, "dur": 43, "text": "还在你身上"}, {"from": 11270, "dur": 76, "text": "只是公司不再隔着屏幕"}, {"from": 11350, "dur": 50, "text": "认这个凭证了"}, {"from": 11405, "dur": 76, "text": "它要看你做出来的东西"}, {"from": 11485, "dur": 89, "text": "我把那个问题也留给了自己："}, {"from": 11579, "dur": 76, "text": "我有什么非共识的判断"}, {"from": 11659, "dur": 43, "text": "这期先不答"}, {"from": 11707, "dur": 50, "text": "想清楚了再说"}], "source": "estimate"}