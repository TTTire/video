0": 4039, "2.1": 4105, "2.2": 4666, "2.3": 4992, "2.4": 5653, "2.5": 5864, "2.6": 6464, "2.7": 6697, "2.8": 6959, "2.9": 7385, "3.0": 7553, "3.1": 7619, "3.2": 8428, "3.3": 8828, "3.4": 9524, "3.5": 9524, "3.6": 10111}, "subs": [{"from": 6, "dur": 29, "text": "哈喽大家好"}, {"from": 41, "dur": 65, "text": "杭州马上要开一场演唱会"}, {"from": 107, "dur": 42, "text": "票面50的惠民票"}, {"from": 149, "dur": 104, "text": "却在二手市场被人挂了988一张"}, {"from": 264, "dur": 46, "text": "贵了整整快20倍"}, {"from": 311, "dur": 49, "text": "这个歌手沉寂多年"}, {"from": 362, "dur": 48, "text": "却被一档综艺带火"}, {"from": 419, "dur": 77, "text": "这是她出道20年的纪念演出"}, {"from": 497, "dur": 84, "text": "票价翻倍成这样也是大家没有想到的"}, {"from": 583, "dur": 51, "text": "在上一期视频的结尾"}, {"from": 635, "dur": 91, "text": "我们讲了那部华强北手机 还记得吗"}, {"from": 727, "dur": 107, "text": "1399 买到原价近3000块的手机"}, {"from": 841, "dur": 82, "text": "第一反应是 哇 赚了1600"}, {"from": 925, "dur": 99, "text": "可这边50块的票价挂988"}, {"from": 1032, "dur": 73, "text": "第一反应是 亏了将近20倍"}, {"from": 1108, "dur": 41, "text": "一个赚一个亏"}, {"from": 1152, "dur": 69, "text": "但这笔账你是不是算错了呢"}, {"from": 1224, "dur": 97, "text": "赚多少跟价签上的价格关系其实不大"}, {"from": 1323, "dur": 68, "text": "两边的账都不应该这样去算"}, {"from": 1393, "dur": 78, "text": "这里是像素呼吸的100个经济学原理"}, {"from": 1472, "dur": 65, "text": "第10个 消费者剩余"}, {"from": 1545, "dur": 62, "text": "上期我们留了一个问题"}, {"from": 1608, "dur": 87, "text": "那份赚到了 到底赚了多少呢"}, {"from": 1723, "dur": 89, "text": "在价格表上会有一个原价和一个现价"}, {"from": 1817, "dur": 80, "text": "那么两个数字相加减 谁都会计算"}, {"from": 1898, "dur": 98, "text": "而这样计算的方法也是商家希望你去做的"}, {"from": 2008, "dur": 84, "text": "可原价是谁写的呢 还不是卖家"}, {"from": 2101, "dur": 71, "text": "国家还专门立了规矩去管制它"}, {"from": 2175, "dur": 101, "text": "而在经济学里 赚到了用的是另一个数"}, {"from": 2288, "dur": 67, "text": "你心里的价位到底是多少"}, {"from": 2359, "dur": 63, "text": "它减掉你实际掏的钱"}, {"from": 2424, "dur": 91, "text": "那么剩下的那部分就叫消费者剩余"}, {"from": 2516, "dur": 57, "text": "而这个数字只在你心里"}, {"from": 2577, "dur": 72, "text": "在价格表上却并没有展现出来"}, {"from": 2652, "dur": 50, "text": "卖家也确实看不见"}, {"from": 2710, "dur": 68, "text": "经济学家想计算它都很难"}, {"from": 2781, "dur": 45, "text": "如果真的要计算这个"}, {"from": 2827, "dur": 90, "text": "那么就需要把每个人心中的那个数字找到"}, {"from": 2919, "dur": 66, "text": "而演唱会还有更细的行情"}, {"from": 2997, "dur": 72, "text": "820块钱的票被卖到5000块"}, {"from": 3070, "dur": 106, "text": "320档位的票 两张打包卖3600"}, {"from": 3183, "dur": 90, "text": "而最便宜的那档反而被炒的倍数最高"}, {"from": 3276, "dur": 57, "text": "一份演出票务的调研"}, {"from": 3334, "dur": 63, "text": "问过1000个买票的人"}, {"from": 3406, "dur": 99, "text": "而特别喜欢的演出 八成多的人可以接受"}, {"from": 3507, "dur": 112, "text": "比票面价格贵10%到80%之间"}, {"from": 3629, "dur": 50, "text": "而一张票两个价"}, {"from": 3691, "dur": 121, "text": "主办方写的价格和你心里的价格真的对等吗"}, {"from": 3814, "dur": 84, "text": "而赚没赚需要看你心里的那个数字"}, {"from": 3900, "dur": 59, "text": "不要去看它的真实价格"}, {"from": 3961, "dur": 86, "text": "那要是一样东西它根本没有价格呢"}, {"from": 4075, "dur": 88, "text": "而按照原价去减现价折算的话"}, {"from": 4164, "dur": 76, "text": "有一类东西你会觉得一分没赚"}, {"from": 4247, "dur": 85, "text": "但是你天天在用 一分钱也没有花"}, {"from": 4344, "dur": 120, "text": "比如我们日常用的地图 搜索引擎 邮箱"}, {"from": 4471, "dur": 80, "text": "它的原价是零 现价也是零"}, {"from": 4553, "dur": 49, "text": "而在你的心里也并没有"}, {"from": 4601, "dur": 63, "text": "对它产生一些心理预期"}, {"from": 4666, "dur": 96, "text": "在2019年 美国科学院的院刊上"}, {"from": 4762, "dur": 62, "text": "有一篇文章做了一个大实验"}, {"from": 4826, "dur": 72, "text": "他去问美国网民 给你多少钱"}, {"from": 4897, "dur": 84, "text": "你肯一年不用某一类免费的东西"}, {"from": 4992, "dur": 31, "text": "先看最狠的"}, {"from": 5028, "dur": 75, "text": "光一个搜索引擎 一整年不用"}, {"from": 5104, "dur": 102, "text": "中位数就要省掉17530美元"}, {"from": 5217, "dur": 86, "text": "而邮箱可以省掉8414美元"}, {"from": 5311, "dur": 125, "text": "而地图大约可以省掉3600美元左右的资源"}, {"from": 5439, "dur": 74, "text": "而这些东西你一分钱也没付"}, {"from": 5517, "dur": 53, "text": "可心里的价格这么高"}, {"from": 5572, "dur": 79, "text": "差出来的那一大截全部都归你自己"}, {"from": 5653, "dur": 102, "text": "这里问的是 给你多少钱你才肯放弃"}, {"from": 5755, "dur": 43, "text": "这一类免费的APP"}, {"from": 5800, "dur": 63, "text": "而不是你肯掏多少钱"}, {"from": 5864, "dur": 70, "text": "而真正兑现的那一组人也一样"}, {"from": 5937, "dur": 66, "text": "每200个人中去抽一个人"}, {"from": 6005, "dur": 99, "text": "抽中就按照他选择的方式进行兑现"}, {"from": 6106, "dur": 88, "text": "选了多少钱 那么就真正的给他多少钱"}, {"from": 6202, "dur": 44, "text": "也真的让他停用"}, {"from": 6252, "dur": 62, "text": "比如停用一个月Facebook"}, {"from": 6316, "dur": 75, "text": "中位数差不多在40美元上下"}, {"from": 6392, "dur": 65, "text": "是美国网民可以接受的价格"}, {"from": 6463, "dur": 93, "text": "而换成国内的微信 导航 或者搜索呢"}, {"from": 6565, "dur": 57, "text": "这方面也真的没人算过"}, {"from": 6634, "dur": 51, "text": "你可以自己去评估一下"}, {"from": 6697, "dur": 71, "text": "我的理解是 剩余最大的地方"}, {"from": 6769, "dur": 68, "text": "往往是你不觉得赚了的地方"}, {"from": 6847, "dur": 51, "text": "因为没有价格提醒你"}, {"from": 6899, "dur": 58, "text": "我在这方面到底省了多少"}, {"from": 6959, "dur": 49, "text": "回到开头的那两件事"}, {"from": 7015, "dur": 73, "text": "原价3000的手机 让你盯着"}, {"from": 7089, "dur": 74, "text": "我1500买到 省到了1500"}, {"from": 7166, "dur": 85, "text": "而票面50 让你盯着贵了多少"}, {"from": 7252, "dur": 39, "text": "是赚还是亏"}, {"from": 7301, "dur": 82, "text": "看的是 你到底对它有多需要"}, {"from": 7385, "dur": 88, "text": "而消费者剩余 藏在你心里的那个数里"}, {"from": 7477, "dur": 85, "text": "在你掏钱之前 你知道它是多少吗"}, {"from": 7589, "dur": 91, "text": "不过 消费者剩余并不是你省得越多"}, {"from": 7681, "dur": 31, "text": "那么就越赚"}, {"from": 7723, "dur": 42, "text": "同样省1000块"}, {"from": 7767, "dur": 69, "text": "手头紧的人和手头富裕的人"}, {"from": 7838, "dur": 41, "text": "分量是不一样的"}, {"from": 7881, "dur": 61, "text": "你付出去的也不只是钱"}, {"from": 7943, "dur": 87, "text": "西湖那边的那家奶茶店 十来块一杯"}, {"from": 8032, "dur": 53, "text": "排队还要一个小时以上"}, {"from": 8091, "dur": 95, "text": "而旁边的三明治店 队伍排了七八十米"}, {"from": 8188, "dur": 66, "text": "有人专门从无锡过去"}, {"from": 8256, "dur": 79, "text": "排队一小时去享受那样的美食"}, {"from": 8337, "dur": 91, "text": "而那一个多小时也是他付出去的价格"}, {"from": 8429, "dur": 46, "text": "所以 在掏钱之前"}, {"from": 8477, "dur": 109, "text": "心里先对一个东西有一个简单的预期"}, {"from": 8596, "dur": 55, "text": "这个东西我肯付出多少"}, {"from": 8657, "dur": 70, "text": "先想好 再去看它的价格表"}, {"from": 8734, "dur": 83, "text": "如果价格比它低 那么才是真的赚到"}, {"from": 8828, "dur": 29, "text": "双十一刚过"}, {"from": 8859, "dur": 67, "text": "购物车里的东西正好拿来练手"}, {"from": 8929, "dur": 105, "text": "每一件 先问自己的心理预期价格到底是多少"}, {"from": 9045, "dur": 93, "text": "再拿我们真正付出去的钱去跟这个相比"}, {"from": 9149, "dur": 77, "text": "如果现价比它高 那么就不算赚"}, {"from": 9234, "dur": 79, "text": "今年天猫把跨店满减给拿掉了"}, {"from": 9321, "dur": 85, "text": "改成一件直接打折 最高减15%"}, {"from": 9428, "dur": 94, "text": "现价直接摆给你 这样更方便去对比"}, {"from": 9524, "dur": 65, "text": "回到那张票和那部手机"}, {"from": 9592, "dur": 63, "text": "50块的票卖988"}, {"from": 9663, "dur": 61, "text": "要是你心里愿意出1500"}, {"from": 9726, "dur": 86, "text": "那么988拿下来 依然是赚到了"}, {"from": 9824, "dur": 56, "text": "而1399的手机"}, {"from": 9883, "dur": 59, "text": "对专程来买手机的人"}, {"from": 9944, "dur": 34, "text": "可能真的赚了"}, {"from": 9986, "dur": 53, "text": "但真的赚还是不赚"}, {"from": 10041, "dur": 69, "text": "取决于你心里的心理预期价位"}, {"from": 10111, "dur": 70, "text": "而票价对谁都是一样的"}, {"from": 10188, "dur": 43, "text": "可要是主办方知道"}, {"from": 10232, "dur": 63, "text": "你心里愿意出5000块呢"}, {"from": 10297, "dur": 62, "text": "下一期我们一起来聊一聊"}, {"from": 10358, "dur": 81, "text": "第11个话题 价格歧视"}], "source": "starts"}